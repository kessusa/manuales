# avi_client.py
import os
import json
import urllib3
from datetime import datetime
from avi.sdk.avi_api import ApiSession

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

AVI_CONTROLLER = os.getenv("AVI_CONTROLLER", "10.0.0.10")
AVI_USER = os.getenv("AVI_USER", "admin")
AVI_PASSWORD = os.getenv("AVI_PASSWORD", "VMware1!")
AVI_TENANT = os.getenv("AVI_TENANT", "admin")
AVI_VERSION = os.getenv("AVI_VERSION", "22.1.5")

def get_session():
    return ApiSession.get_session(
        controller_ip=AVI_CONTROLLER,
        username=AVI_USER,
        password=AVI_PASSWORD,
        tenant=AVI_TENANT,
        api_version=AVI_VERSION,
        verify=False
    )

def fetch_all(api, endpoint, params=None):
    """Obtiene todos los objetos manejando la paginación de Avi"""
    query = {"page_size": 200}
    if params:
        query.update(params)
    resp = api.get(endpoint, params=query)
    resp.raise_for_status()
    return resp.json().get("results", [])

def filter_policies(api, policy_filter=None):
    policies = fetch_all(api, "wafpolicy")
    if policy_filter:
        return [p for p in policies if policy_filter.lower() in p["name"].lower()]
    return policies

def backup_policy(policy):
    os.makedirs("backups", exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    fname = f"backups/{policy['name']}_{ts}.json"
    with open(fname, "w", encoding="utf-8") as f:
        json.dump(policy, f, indent=2)
    return fname


# 01_map_waf_to_backends.py
import argparse
import json
from avi_client import get_session, fetch_all

def extract_uuid(ref_url):
    return ref_url.split("/")[-1] if ref_url else None

def map_waf_inventory(policy_filter=None, export_json=False):
    api = get_session()
    waf_policies = {p["uuid"]: p for p in fetch_all(api, "wafpolicy")}
    vservices = fetch_all(api, "virtualservice")
    pools = {p["uuid"]: p for p in fetch_all(api, "pool")}
    poolgroups = {pg["uuid"]: pg for pg in fetch_all(api, "poolgroup")}

    inventory = {}

    for waf_uuid, waf in waf_policies.items():
        if policy_filter and policy_filter.lower() not in waf["name"].lower():
            continue
        inventory[waf["name"]] = {
            "waf_uuid": waf_uuid,
            "mode": waf.get("mode"),
            "virtual_services": []
        }

    for vs in vservices:
        waf_ref = vs.get("waf_policy_ref")
        if not waf_ref:
            continue
        waf_uuid = extract_uuid(waf_ref)
        if waf_uuid not in waf_policies:
            continue
        waf_name = waf_policies[waf_uuid]["name"]
        if waf_name not in inventory:
            continue

        # Localizar todos los Pools asociados al Virtual Service (directos o vía PoolGroup)
        associated_pool_uuids = set()
        if vs.get("pool_ref"):
            associated_pool_uuids.add(extract_uuid(vs["pool_ref"]))
        if vs.get("pool_group_ref"):
            pg_uuid = extract_uuid(vs["pool_group_ref"])
            pg = poolgroups.get(pg_uuid, {})
            for member in pg.get("members", []):
                if member.get("pool_ref"):
                    associated_pool_uuids.add(extract_uuid(member["pool_ref"]))

        # Extraer los servidores físicos/VMs dentro de cada Pool
        vs_pools_info = []
        for p_uuid in associated_pool_uuids:
            pool_obj = pools.get(p_uuid)
            if not pool_obj:
                continue
            default_port = pool_obj.get("default_server_port", 80)
            servers_list = []
            for srv in pool_obj.get("servers", []):
                ip_addr = srv.get("ip", {}).get("addr", "N/A")
                hostname = srv.get("hostname", ip_addr)
                port = srv.get("port", default_port)
                enabled = srv.get("enabled", True)
                servers_list.append({
                    "ip": ip_addr,
                    "hostname": hostname,
                    "port": port,
                    "enabled": enabled
                })
            vs_pools_info.append({
                "pool_name": pool_obj["name"],
                "servers": servers_list
            })

        inventory[waf_name]["virtual_services"].append({
            "vs_name": vs["name"],
            "enabled": vs.get("enabled", True),
            "pools": vs_pools_info
        })

    # Mostrar por pantalla de forma clara
    for waf_name, data in inventory.items():
        print(f"\n==========================================")
        print(f"WAF POLICY: {waf_name} (Modo: {data['mode']})")
        print(f"==========================================")
        if not data["virtual_services"]:
            print("  [!] Sin Virtual Services asociados actualmente.")
        for vs in data["virtual_services"]:
            print(f"  └── Virtual Service: {vs['vs_name']} (Activo: {vs['enabled']})")
            for p in vs["pools"]:
                print(f"       └── Pool: {p['pool_name']}")
                for s in p["servers"]:
                    status = "UP/ENABLED" if s["enabled"] else "DISABLED"
                    print(f"            • Servidor: {s['ip']}:{s['port']} ({s['hostname']}) [{status}]")

    if export_json:
        with open("waf_backend_inventory.json", "w", encoding="utf-8") as f:
            json.dump(inventory, f, indent=2)
        print("\n[+] Inventario exportado a waf_backend_inventory.json")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Mapea qué servidores backend están detrás de cada política WAF")
    parser.add_argument("--filter", help="Filtrar por nombre de política WAF")
    parser.add_argument("--json", action="store_true", help="Exportar resultado a JSON")
    args = parser.parse_args()
    map_waf_inventory(args.filter, args.json)


# 02_audit_waf_overrides.py
import argparse
from avi_client import get_session, filter_policies

def audit_overrides(policy_filter=None):
    api = get_session()
    policies = filter_policies(api, policy_filter)

    for p in policies:
        print(f"\n------------------------------------------------------------")
        print(f"Política: {p['name']} | Modo: {p.get('mode')} | Paranoia: {p.get('paranoia_level')}")
        print(f"Delegación de Modo: {p.get('allow_mode_delegation', False)}")
        print(f"------------------------------------------------------------")

        # 1. Reglas Pre-CRS
        pre_groups = p.get("pre_crs_groups", [])
        print(f"  [Pre-CRS Groups]: {len(pre_groups)}")
        for g in pre_groups:
            for r in g.get("rules", []):
                print(f"    • [{g['name']}] ID {r.get('rule_id')} - {r.get('name')} | Activa: {r.get('enable')} | Modo: {r.get('mode')}")

        # 2. CRS Overrides (Avi 22.1+)
        crs_overrides = p.get("crs_overrides", [])
        if crs_overrides:
            print(f"  [CRS Overrides configurados]:")
            for ov in crs_overrides:
                g_name = ov.get("name")
                g_enable = ov.get("enable", "Default")
                print(f"    • Grupo: {g_name} (Enable override: {g_enable})")
                for r_ov in ov.get("rule_overrides", []):
                    r_id = r_ov.get("rule_id")
                    r_en = r_ov.get("enable", "Default")
                    r_mode = r_ov.get("mode", "Default")
                    excl = len(r_ov.get("exclude_list", []))
                    print(f"       └── Regla {r_id}: Enable={r_en}, Mode={r_mode}, Exclusiones={excl}")

        # 3. En versiones con crs_groups embebido, listar reglas deshabilitadas o con exclusiones
        elif p.get("crs_groups"):
            print("  [CRS Groups (Árbol directo)]:")
            for g in p.get("crs_groups", []):
                if not g.get("enable", True):
                    print(f"    • Grupo DESHABILITADO: {g['name']}")
                for r in g.get("rules", []):
                    if not r.get("enable", True) or r.get("exclude_list"):
                        print(f"       └── Regla {r['rule_id']} ({g['name']}): Enable={r.get('enable')}, Mode={r.get('mode')}, Excl={len(r.get('exclude_list', []))}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Obtiene los overrides, exclusiones y reglas Pre-CRS de las políticas")
    parser.add_argument("--filter", help="Filtrar por nombre de política")
    args = parser.parse_args()
    audit_overrides(args.filter)


# 03_manage_pre_crs.py
import argparse
from avi_client import get_session, filter_policies, backup_policy

GROUP_NAME = "00_Emergency_Virtual_Patching"

def manage_pre_crs(action, rule_id, rule_name=None, sec_rule=None, mode="WAF_MODE_ENFORCEMENT", policy_filter=None, dry_run=False):
    api = get_session()
    policies = filter_policies(api, policy_filter)

    for p in policies:
        pre_groups = p.get("pre_crs_groups", [])
        target_group = next((g for g in pre_groups if g["name"] == GROUP_NAME), None)
        changed = False

        if action == "add":
            if not target_group:
                for idx, g in enumerate(pre_groups):
                    g["index"] = idx + 1
                target_group = {"index": 0, "name": GROUP_NAME, "enable": True, "rules": []}
                pre_groups.insert(0, target_group)

            rules = target_group.setdefault("rules", [])
            existing = next((r for r in rules if str(r.get("rule_id")) == str(rule_id)), None)
            rule_payload = {
                "name": rule_name or f"Custom_{rule_id}",
                "rule_id": str(rule_id),
                "enable": True,
                "mode": mode,
                "rule": sec_rule,
                "is_sensitive": False
            }
            if existing:
                existing.update(rule_payload)
            else:
                rule_payload["index"] = len(rules) + 1
                rules.append(rule_payload)
            p["pre_crs_groups"] = pre_groups
            changed = True

        elif action == "delete" and target_group:
            orig_len = len(target_group.get("rules", []))
            target_group["rules"] = [r for r in target_group.get("rules", []) if str(r.get("rule_id")) != str(rule_id)]
            if len(target_group["rules"]) < orig_len:
                for idx, r in enumerate(target_group["rules"]):
                    r["index"] = idx + 1
                changed = True

        if not changed:
            continue

        if dry_run:
            print(f"[DRY-RUN] Acción '{action}' para regla {rule_id} en política '{p['name']}'")
            continue

        backup_policy(p)
        resp = api.put(f"wafpolicy/{p['uuid']}", data=p)
        print(f"[{'+' if resp.status_code == 200 else '!'}] '{p['name']}' -> HTTP {resp.status_code}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Añade o elimina reglas Pre-CRS en tus políticas WAF")
    parser.add_argument("action", choices=["add", "delete"], help="Añadir/actualizar o borrar la regla")
    parser.add_argument("--id", required=True, help="ID numérico de la regla (ej. 100099)")
    parser.add_argument("--name", help="Nombre de la regla (requerido para 'add')")
    parser.add_argument("--rule", help="Cadena SecRule de ModSecurity (requerida para 'add')")
    parser.add_argument("--mode", default="WAF_MODE_ENFORCEMENT", choices=["WAF_MODE_ENFORCEMENT", "WAF_MODE_DETECTION_ONLY"])
    parser.add_argument("--filter", help="Aplicar solo a políticas cuyo nombre contenga este texto")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    manage_pre_crs(args.action, args.id, args.name, args.rule, args.mode, args.filter, args.dry_run)


# 04_manage_crs_signatures.py
import argparse
from avi_client import get_session, filter_policies, backup_policy

def update_crs_signatures(groups=None, rules=None, enable=True, mode="WAF_MODE_ENFORCEMENT", policy_filter=None, dry_run=False):
    api = get_session()
    policies = filter_policies(api, policy_filter)
    target_groups = set(groups or [])
    target_rules = set(str(r) for r in (rules or []))

    for p in policies:
        changed = False

        # Soporte para estructura crs_groups tradicional
        if p.get("crs_groups"):
            for g in p["crs_groups"]:
                if g["name"] in target_groups:
                    g["enable"] = enable
                    for r in g.get("rules", []):
                        r["enable"] = enable
                        r["mode"] = mode
                    changed = True
                for r in g.get("rules", []):
                    if str(r.get("rule_id")) in target_rules:
                        if enable:
                            g["enable"] = True
                        r["enable"] = enable
                        r["mode"] = mode
                        changed = True

        # Soporte para estructura crs_overrides (Avi 22.1+)
        else:
            overrides = p.setdefault("crs_overrides", [])
            for g_name in target_groups:
                ov = next((o for o in overrides if o.get("name") == g_name), None)
                if not ov:
                    ov = {"name": g_name}
                    overrides.append(ov)
                ov["enable"] = enable
                changed = True

            if target_rules and p.get("waf_crs_ref"):
                crs_uuid = p["waf_crs_ref"].split("/")[-1]
                crs_catalog = api.get(f"wafcrs/{crs_uuid}").json()
                for cg in crs_catalog.get("groups", []):
                    matched = [r["rule_id"] for r in cg.get("rules", []) if str(r.get("rule_id")) in target_rules]
                    if matched:
                        ov = next((o for o in overrides if o.get("name") == cg["name"]), None)
                        if not ov:
                            ov = {"name": cg["name"], "enable": True, "rule_overrides": []}
                            overrides.append(ov)
                        elif enable:
                            ov["enable"] = True
                        r_ovs = ov.setdefault("rule_overrides", [])
                        for rid in matched:
                            rov = next((x for x in r_ovs if str(x.get("rule_id")) == str(rid)), None)
                            if not rov:
                                rov = {"rule_id": str(rid)}
                                r_ovs.append(rov)
                            rov["enable"] = enable
                            rov["mode"] = mode
                        changed = True

        if not changed:
            continue
        if dry_run:
            print(f"[DRY-RUN] Modificación CRS preparada en '{p['name']}'")
            continue

        backup_policy(p)
        resp = api.put(f"wafpolicy/{p['uuid']}", data=p)
        print(f"[+] Política '{p['name']}' actualizada -> HTTP {resp.status_code}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Modifica estado y modo de grupos o firmas CRS")
    parser.add_argument("--groups", nargs="+", help="Nombres de los grupos CRS")
    parser.add_argument("--rules", nargs="+", help="IDs de las reglas CRS")
    parser.add_argument("--disable", action="store_true", help="Deshabilitar en lugar de habilitar")
    parser.add_argument("--mode", default="WAF_MODE_ENFORCEMENT", choices=["WAF_MODE_ENFORCEMENT", "WAF_MODE_DETECTION_ONLY"])
    parser.add_argument("--filter", help="Filtrar por nombre de política")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    update_crs_signatures(args.groups, args.rules, not args.disable, args.mode, args.filter, args.dry_run)


# 05_set_policy_mode.py
import argparse
from avi_client import get_session, filter_policies, backup_policy

def set_policy_state(mode=None, paranoia=None, delegation=None, policy_filter=None, dry_run=False):
    api = get_session()
    policies = filter_policies(api, policy_filter)

    for p in policies:
        if mode:
            p["mode"] = mode
        if paranoia:
            p["paranoia_level"] = paranoia
        if delegation is not None:
            p["allow_mode_delegation"] = delegation

        if dry_run:
            print(f"[DRY-RUN] '{p['name']}' -> Mode: {p['mode']}, Paranoia: {p['paranoia_level']}, Delegation: {p.get('allow_mode_delegation')}")
            continue

        backup_policy(p)
        resp = api.put(f"wafpolicy/{p['uuid']}", data=p)
        print(f"[+] '{p['name']}' actualizada -> HTTP {resp.status_code}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Modifica el estado global de las políticas WAF")
    parser.add_argument("--mode", choices=["WAF_MODE_ENFORCEMENT", "WAF_MODE_DETECTION_ONLY"])
    parser.add_argument("--paranoia", choices=["WAF_PARANOIA_LEVEL_LOW", "WAF_PARANOIA_LEVEL_MEDIUM", "WAF_PARANOIA_LEVEL_HIGH", "WAF_PARANOIA_LEVEL_EXTREME"])
    parser.add_argument("--enable-delegation", action="store_true", help="Permite que reglas en Enforcement bloqueen aunque la política esté en Detection")
    parser.add_argument("--filter", help="Filtrar por nombre de política")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    deleg = True if args.enable_delegation else None
    set_policy_state(args.mode, args.paranoia, deleg, args.filter, args.dry_run)


# 06_rollback_policy.py
import json
import sys
from avi_client import get_session

def rollback(backup_file):
    api = get_session()
    with open(backup_file, "r", encoding="utf-8") as f:
        policy_data = json.load(f)

    uuid = policy_data["uuid"]
    name = policy_data["name"]
    resp = api.put(f"wafpolicy/{uuid}", data=policy_data)
    if resp.status_code == 200:
        print(f"[+] Rollback completado con éxito para '{name}' desde {backup_file}")
    else:
        print(f"[!] Error en rollback ({resp.status_code}): {resp.text}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Uso: python 06_rollback_policy.py backups/<archivo_backup.json>")
        sys.exit(1)
    rollback(sys.argv[1])

Para utilizar esta suite de scripts, primero debes configurar las credenciales de conexión a tu Avi Controller mediante variables de entorno (AVI_CONTROLLER, AVI_USER, AVI_PASSWORD y AVI_VERSION) 
en la terminal desde donde vayas a operar. Ante una nueva alerta o vulnerabilidad, el flujo de trabajo recomendado comienza ejecutando los scripts de consulta (01_map_waf_to_backends.py y 02_audit_waf_overrides.py) 
para identificar qué servidores backend están expuestos detrás de cada política y revisar qué reglas están activas actualmente. A continuación, puedes desplegar parches virtuales con 03_manage_pre_crs.py, 
activar firmas o grupos específicos con 04_manage_crs_signatures.py, o cambiar el modo global de las políticas con 05_set_policy_mode.py, añadiendo siempre primero el parámetro --dry-run 
para simular la acción sin impactar el tráfico y usando --filter si deseas acotar el cambio a una política concreta. Al ejecutar el comando definitivo sin --dry-run, la herramienta generará automáticamente una copia 
de seguridad en la carpeta backups/ antes de aplicar los cambios en el controlador, lo que te permite revertir cualquier política a su estado exacto anterior en cuestión de segundos ejecutando 06_rollback_policy.py 
junto a la ruta del archivo JSON respaldado
