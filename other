## 6. Bloque 3: Akamai Application Security (AppSec API v1)

### 6.1. Módulo Base Akamai: `akamai_client.py`
Gestiona la firma EdgeGrid, exporta backups completos de la configuración en `./backups_akamai/` y clona automáticamente la última versión activa en `PRODUCTION` cuando es necesario editar una configuración inmutable.

```python
# akamai_client.py
import os
import json
import requests
from datetime import datetime
from urllib.parse import urljoin
from akamai.edgegrid import EdgeGridAuth, EdgeRc

EDGERC_PATH = os.getenv("AKAMAI_EDGERC", os.path.expanduser("~/.edgerc"))
EDGERC_SECTION = os.getenv("AKAMAI_SECTION", "default")

class AkamaiAppSecClient:
    def __init__(self):
        self.session = requests.Session()
        if os.path.exists(EDGERC_PATH):
            edgerc = EdgeRc(EDGERC_PATH)
            self.base_url = f"https://{edgerc.get(EDGERC_SECTION, 'host')}"
            self.session.auth = EdgeGridAuth.from_edgerc(edgerc, EDGERC_SECTION)
        else:
            self.base_url = f"https://{os.getenv('AKAMAI_HOST', 'akab-xxxx.luna.akamaiapis.net')}"
            self.session.auth = EdgeGridAuth(
                client_token=os.getenv("AKAMAI_CLIENT_TOKEN", ""),
                client_secret=os.getenv("AKAMAI_CLIENT_SECRET", ""),
                access_token=os.getenv("AKAMAI_ACCESS_TOKEN", "")
            )
        self.session.headers.update({"Content-Type": "application/json", "Accept": "application/json"})

    def get(self, path, params=None):
        r = self.session.get(urljoin(self.base_url, path), params=params, timeout=60)
        r.raise_for_status()
        return r.json()

    def put(self, path, data):
        r = self.session.put(urljoin(self.base_url, path), json=data, timeout=60)
        r.raise_for_status()
        return r.json() if r.text else {}

    def post(self, path, data):
        r = self.session.post(urljoin(self.base_url, path), json=data, timeout=60)
        r.raise_for_status()
        return r.json() if r.text else {}

    def get_editable_or_clone_version(self, config_id, base_env="PRODUCTION"):
        cfg = self.get(f"/appsec/v1/configs/{config_id}")
        latest_v = cfg.get("latestVersion", 1)
        prod_v = cfg.get("productionVersion", latest_v)
        stag_v = cfg.get("stagingVersion", latest_v)

        if latest_v != prod_v and latest_v != stag_v:
            return latest_v

        clone_from = prod_v if base_env == "PRODUCTION" and prod_v else latest_v
        print(f"[*] Clonando versión {clone_from} de Config {config_id} para crear nueva versión editable...")
        res = self.post(f"/appsec/v1/configs/{config_id}/versions", {
            "createFromVersion": clone_from,
            "ruleUpdate": False
        })
        return res["version"]

    def backup_config_version(self, config_id, version):
        os.makedirs("backups_akamai", exist_ok=True)
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        export_data = self.get(f"/appsec/v1/export/configs/{config_id}/versions/{version}")
        fname = f"backups_akamai/cfg_{config_id}_v{version}_{ts}.json"
        with open(fname, "w", encoding="utf-8") as f:
            json.dump(export_data, f, indent=2)
        return fname
```

