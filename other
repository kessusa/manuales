### 6.4. Custom Rules (0-Day Patching), Excepciones y Activación: `akamai_03_custom_rules_and_exceptions.py`
* **Qué hace:** Dispone de 3 subcomandos:
  1. `custom-rule`: Crea e inyecta una regla personalizada en modo `deny`.
  2. `exception`: Añade una excepción de ruta (`pathMatch`) o parámetro (`REQUEST_PARAMS`) a un `rule_id`.
  3. `activate`: Despliega la versión editable en la red `STAGING` o `PRODUCTION` de Akamai.

```python
# akamai_03_custom_rules_and_exceptions.py
import argparse
from akamai_client import AkamaiAppSecClient

def create_and_enforce_custom_rule(ak, config_id, ver, policy_id, rule_name, path_match, header_name=None, regex_val=None):
    conditions = [{"type": "pathMatch", "positiveMatch": True, "value": [path_match]}]
    if header_name and regex_val:
        conditions.append({
            "type": "requestHeaderValueMatch",
            "positiveMatch": True,
            "name": header_name,
            "value": [regex_val],
            "valueWildcard": True,
            "valueCase": False
        })

    custom_rule_payload = {
        "name": rule_name,
        "description": "Emergency Virtual Patching via SecOps Script",
        "conditions": conditions
    }
    created = ak.post(f"/appsec/v1/configs/{config_id}/custom-rules", custom_rule_payload)
    c_rule_id = created["id"]
    print(f"[+] Custom Rule '{rule_name}' creada con ID {c_rule_id}")

    ak.put(f"/appsec/v1/configs/{config_id}/versions/{ver}/security-policies/{policy_id}/custom-rules/{c_rule_id}", {"action": "deny"})
    print(f"[+] Custom Rule {c_rule_id} activada en modo DENY en la política '{policy_id}'")

def add_rule_exception(ak, config_id, ver, policy_id, rule_id, paths=None, param_names=None):
    exception_payload = {}
    if param_names:
        exception_payload["specificHeaderCookieOrParamNameValue"] = {
            "names": param_names,
            "selector": "REQUEST_PARAMS",
            "wildcard": True
        }
    if paths:
        exception_payload["advancedExceptions"] = {
            "conditions": [{"type": "pathMatch", "positiveMatch": True, "values": paths}]
        }
    ak.put(f"/appsec/v1/configs/{config_id}/versions/{ver}/security-policies/{policy_id}/rules/{rule_id}/condition-exception", exception_payload)
    print(f"[+] Excepción aplicada en Regla {rule_id} (Política '{policy_id}') para Paths={paths}, Params={param_names}")

def activate_version(ak, config_id, ver, network, emails, note="SecOps Automated Deployment"):
    payload = {
        "action": "ACTIVATE",
        "network": network.upper(),
        "note": note,
        "notificationEmails": emails,
        "activationConfigs": [{"configId": config_id, "configVersion": ver}]
    }
    res = ak.post("/appsec/v1/activations", payload)
    print(f"[+] Activación lanzada en {network.upper()} -> ActivationID: {res.get('activationId')} (Estado: {res.get('status')})")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Parcheo Virtual (Custom Rules), Excepciones y Activación en Akamai AppSec")
    parser.add_argument("--config-id", type=int, required=True)
    parser.add_argument("--policy-id", required=True)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_cr = sub.add_parser("custom-rule", help="Crea e inyecta una Custom Rule en modo DENY")
    p_cr.add_argument("--name", required=True, help="Nombre de la regla (ej. Block_CVE_2026)")
    p_cr.add_argument("--path", default="/*", help="URI Path (ej. /api/*)")
    p_cr.add_argument("--header", help="Nombre de cabecera HTTP a inspeccionar")
    p_cr.add_argument("--pattern", help="Patrón o comodín a bloquear en la cabecera")

    p_ex = sub.add_parser("exception", help="Añade una excepción de URI o parámetro a un Rule ID")
    p_ex.add_argument("--rule-id", type=int, required=True, help="ID de la firma ASE (ej. 942100)")
    p_ex.add_argument("--paths", nargs="+", help="Rutas a excluir (ej. /api/v1/checkout)")
    p_ex.add_argument("--params", nargs="+", help="Nombres de parámetros a excluir (ej. xml_body)")

    p_act = sub.add_parser("activate", help="Activa la versión editable en STAGING o PRODUCTION")
    p_act.add_argument("--network", choices=["STAGING", "PRODUCTION"], default="STAGING")
    p_act.add_argument("--emails", nargs="+", required=True, help="Emails de notificación obligatorios en Akamai")
    p_act.add_argument("--note", default="Emergency SecOps update")

    args = parser.parse_args()
    ak = AkamaiAppSecClient()
    ver = ak.get_editable_or_clone_version(args.config_id)

    if args.cmd == "custom-rule":
        create_and_enforce_custom_rule(ak, args.config_id, ver, args.policy_id, args.name, args.path, args.header, args.pattern)
