            overridden_urls = [u for u in urls if u.get("signatureOverridesReference", {}).get("items")]
            print(f"\n  [Excepciones en URLs (URI Path)]: {len(overridden_urls)}")
            for u in overridden_urls:
                ov_list = u["signatureOverridesReference"]["items"]
                sig_ids = [str(o.get("signatureReference", {}).get("signatureId")) for o in ov_list]
                print(f"    • URL '{u.get('name')}' ({u.get('protocol')}) -> Excluye SigIDs: {', '.join(sig_ids)}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Audita Signature Sets, Whitelists y Overrides de URL/Parámetros en F5 ASM")
    parser.add_argument("--filter", help="Filtrar por nombre de política")
    parser.add_argument("--details", action="store_true", help="Mostrar el detalle de firmas excluidas por URL y Parámetro")
