### 7.4. Consolidación Segura de Políticas: `fmg_03_consolidate_policies.py`
* **Qué hace:** Agrupa reglas equivalentes (mismas interfaces, NAT, acción y perfiles UTM) que difieren en un solo eje (`srcaddr`, `dstaddr` o `service`), deteniendo la ventana de fusión si existe una regla `DENY` intermedia.
* **Argumentos:** `--adom`, `--pkg`, `--tag`, `--apply`.

```python
# fmg_03_consolidate_policies.py
import argparse
from fmg_client import FortiManagerAPI, backup_package

def as_list(val):
    if isinstance(val, list):
        return sorted(list(set(val)))
    return [val] if val else []

def get_base_signature(pol):
    return (
        tuple(as_list(pol.get("srcintf"))),
        tuple(as_list(pol.get("dstintf"))),
        pol.get("action"), pol.get("nat"), pol.get("schedule"), pol.get("utm-status"),
        tuple(as_list(pol.get("av-profile"))),
        tuple(as_list(pol.get("ips-sensor"))),
        tuple(as_list(pol.get("webfilter-profile"))),
        tuple(as_list(pol.get("application-list"))),
        tuple(as_list(pol.get("ssl-ssh-profile")))
    )

def consolidate_rules(adom, pkg, tag_filter=None, apply_changes=False):
    fmg = FortiManagerAPI()
    fmg.login()

    try:
        policies = fmg.get_policies(adom, pkg)
        backup_package(adom, pkg, policies)

        merges = []
        skip_ids = set()

        for i, pol_a in enumerate(policies):
            if pol_a.get("status") == "disable" or pol_a["policyid"] in skip_ids:
                continue
            if tag_filter and tag_filter.lower() not in str(pol_a.get("global-label", "")).lower():
                continue

            sig_a = get_base_signature(pol_a)
            a_src = set(as_list(pol_a.get("srcaddr")))
            a_dst = set(as_list(pol_a.get("dstaddr")))
            a_svc = set(as_list(pol_a.get("service")))

            for j in range(i + 1, len(policies)):
                pol_b = policies[j]
                if pol_b.get("status") == "disable" or pol_b["policyid"] in skip_ids:
                    continue
                if pol_b.get("action") != pol_a.get("action"):
                    if set(as_list(pol_b.get("srcintf"))) & set(as_list(pol_a.get("srcintf"))):
                        break
                if get_base_signature(pol_b) != sig_a:
                    continue

                b_src = set(as_list(pol_b.get("srcaddr")))
                b_dst = set(as_list(pol_b.get("dstaddr")))
                b_svc = set(as_list(pol_b.get("service")))

                if sum([a_src != b_src, a_dst != b_dst, a_svc != b_svc]) <= 1:
                    a_src |= b_src
                    a_dst |= b_dst
                    a_svc |= b_svc
                    skip_ids.add(pol_b["policyid"])
                    merges.append({
                        "master_id": pol_a["policyid"],
                        "absorbed_id": pol_b["policyid"],
                        "new_srcaddr": sorted(list(a_src)),
                        "new_dstaddr": sorted(list(a_dst)),
                        "new_service": sorted(list(a_svc))
                    })

        print(f"[*] Detectadas {len(merges)} fusiones seguras de políticas:")
        for m in merges:
            print(f"  • Fusionar PolicyID {m['absorbed_id']} dentro de PolicyID {m['master_id']}")
            print(f"      srcaddr: {m['new_srcaddr']} | dstaddr: {m['new_dstaddr']} | service: {m['new_service']}")

        if apply_changes and merges:
            fmg.lock_adom(adom)
            for m in merges:
                master_url = f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy/{m['master_id']}"
                absorbed_url = f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy/{m['absorbed_id']}"
                fmg._call("update", [{"url": master_url, "data": {"srcaddr": m["new_srcaddr"], "dstaddr": m["new_dstaddr"], "service": m["new_service"]}}])
                fmg._call("update", [{"url": absorbed_url, "data": {"status": "disable", "comments": f"[MERGED INTO POLICY {m['master_id']}]"}}])
            fmg.commit_and_unlock(adom)
            print("[+] Reglas maestras actualizadas y reglas absorbidas deshabilitadas.")
    finally:
        fmg.logout()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Agrupa políticas equivalentes en FortiManager")
    parser.add_argument("--adom", required=True)
    parser.add_argument("--pkg", required=True)
    parser.add_argument("--tag", help="Filtrar por Policy Tag / Global Label")
    parser.add_argument("--apply", action="store_true", help="Aplicar la fusión en FortiManager")
    args = parser.parse_args()
    consolidate_rules(args.adom, args.pkg, args.tag, args.apply)
```

