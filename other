### 5.2. Mapeo `ASM Policy -> LTM Virtual Server -> Pool -> Nodos`: `f5_01_map_backends.py`
* **Qué hace:** Muestra qué Virtual Servers LTM tienen asociada cada política ASM, a qué Pool apuntan y cuáles son las IPs, puertos y estado de los servidores backend.
* **Argumentos:** `--filter <texto>`.

```python
# f5_01_map_backends.py
import argparse
from f5_client import F5AsmClient

def map_f5_inventory(policy_filter=None):
    f5 = F5AsmClient()
    asm_policies = f5.get_policies(policy_filter)
    vservers = f5.get("tm/ltm/virtual", params={"expandSubcollections": "true"}).get("items", [])
    pools = {p["fullPath"]: p for p in f5.get("tm/ltm/pool", params={"expandSubcollections": "true"}).get("items", [])}

    for pol in asm_policies:
        p_name = pol["name"]
        p_path = pol["fullPath"]
        v_names = pol.get("virtualServers", [])

        print(f"\n============================================================")
        print(f"ASM POLICY: {p_path} | Modo: {pol.get('enforcementMode').upper()}")
        print(f"============================================================")

        matched_vs = [vs for vs in vservers if vs["fullPath"] in v_names or p_name in str(vs.get("policiesReference", ""))]
        if not matched_vs:
            print("  [!] Sin Virtual Servers LTM asociados.")
            continue

        for vs in matched_vs:
            vs_dest = vs.get("destination", "N/A")
            pool_path = vs.get("pool")
            print(f"  └── Virtual Server: {vs['fullPath']} (VIP: {vs_dest})")
            if not pool_path or pool_path not in pools:
                print("       └── [Sin Pool directo asignado]")
                continue
            pool_obj = pools[pool_path]
            members = pool_obj.get("membersReference", {}).get("items", [])
            print(f"       └── Pool: {pool_path} ({len(members)} nodos)")
            for m in members:
                print(f"            • Backend: {m.get('address')}:{m.get('name').split(':')[-1]} ({m.get('name')}) [Estado: {m.get('state', 'unknown').upper()}]")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Mapea Políticas F5 ASM -> Virtual Servers -> Pools -> Nodos Backend")
    parser.add_argument("--filter", help="Filtrar por nombre de política ASM")
    args = parser.parse_args()
    map_f5_inventory(args.filter)
