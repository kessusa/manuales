### 7.5. Buscador de Coincidencias y Recomendador de Reglas Candidatas: `fmg_04_smart_policy_finder.py`
* **Qué hace:** Simula de arriba abajo qué política permite o bloquea una lista de orígenes, destinos y puertos (`Fase 1`) y, para el tráfico no permitido, recomienda qué reglas existentes se pueden ampliar calculando su afinidad por subred `/24`, puertos y orígenes (`Fase 2`).
* **Argumentos:** `--adom`, `--pkg`, `--src <ip1> <ip2>`, `--dst <ip3> <ip4>`, `--ports <tcp/443> <udp/53>`, `--tag`.

```python
# fmg_04_smart_policy_finder.py
import argparse
import ipaddress
from fmg_client import FortiManagerAPI

def as_list(val):
    if isinstance(val, list):
        return val
    return [val] if val else []

def build_address_resolver(fmg, adom):
    addrs = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/address"}]) or []
    grps = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/addrgrp"}]) or []

    direct_map = {"all": [ipaddress.ip_network("0.0.0.0/0")], "none": []}
    for a in addrs:
        name = a.get("name")
        atype = a.get("type", "ipmask")
        if atype in (0, "ipmask") and a.get("subnet"):
            sub = a["subnet"]
            try:
                if isinstance(sub, list) and len(sub) == 2:
                    direct_map[name] = [ipaddress.ip_network(f"{sub[0]}/{sub[1]}", strict=False)]
                elif isinstance(sub, str):
                    direct_map[name] = [ipaddress.ip_network(sub.replace(" ", "/"), strict=False)]
            except ValueError:
                pass
        elif atype in (1, "iprange") and a.get("start-ip") and a.get("end-ip"):
            try:
                start = ipaddress.ip_address(a["start-ip"])
                end = ipaddress.ip_address(a["end-ip"])
                direct_map[name] = list(ipaddress.summarize_address_range(start, end))
            except ValueError:
                pass

    grp_map = {g["name"]: as_list(g.get("member")) for g in grps if "name" in g}

    def resolve_names(names, visited=None):
        visited = visited or set()
        nets = []
        for n in names:
            if n in visited:
                continue
            visited.add(n)
            if n in direct_map:
                nets.extend(direct_map[n])
            elif n in grp_map:
                nets.extend(resolve_names(grp_map[n], visited))
        return nets

    return {k: resolve_names([k]) for k in list(direct_map.keys()) + list(grp_map.keys())}

def parse_port_ranges(range_str):
    ranges = []
    if not range_str:
        return ranges
    tokens = range_str if isinstance(range_str, list) else str(range_str).split()
    for token in tokens:
        dst_part = token.split(":")[0]
        if "-" in dst_part:
            p1, p2 = dst_part.split("-", 1)
            ranges.append((int(p1), int(p2)))
        elif dst_part.isdigit():
            p = int(dst_part)
            ranges.append((p, p))
    return ranges

def build_service_resolver(fmg, adom):
    svcs = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/service/custom"}]) or []
    sgrps = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/service/group"}]) or []

    svc_map = {"ALL": {"tcp": [(1, 65535)], "udp": [(1, 65535)], "all": True}}
    for s in svcs:
        name = s.get("name")
        proto = s.get("protocol", "TCP/UDP/SCTP")
        is_all = proto in ("ALL", 6) or (not s.get("tcp-portrange") and not s.get("udp-portrange") and proto == "IP")
        svc_map[name] = {
            "tcp": parse_port_ranges(s.get("tcp-portrange")),
            "udp": parse_port_ranges(s.get("udp-portrange")),
            "all": is_all
        }

    grp_map = {g["name"]: as_list(g.get("member")) for g in sgrps if "name" in g}

    def resolve_svcs(names, visited=None):
        visited = visited or set()
        merged = {"tcp": [], "udp": [], "all": False}
        for n in names:
            if n in visited:
                continue
            visited.add(n)
            if n in svc_map:
                if svc_map[n]["all"]:
                    merged["all"] = True
                merged["tcp"].extend(svc_map[n]["tcp"])
                merged["udp"].extend(svc_map[n]["udp"])
            elif n in grp_map:
                sub = resolve_svcs(grp_map[n], visited)
                if sub["all"]:
                    merged["all"] = True
                merged["tcp"].extend(sub["tcp"])
                merged["udp"].extend(sub["udp"])
        return merged

    return {k: resolve_svcs([k]) for k in list(svc_map.keys()) + list(grp_map.keys())}

def ip_matches_policy_field(ip_net, policy_field_names, addr_catalog):
    if "all" in policy_field_names:
        return True
    return any(ip_net.subnet_of(net) for obj_name in policy_field_names for net in addr_catalog.get(obj_name, []))

def ip_shares_similar_subnet(ip_net, policy_field_names, addr_catalog, prefix_mask=24):
    if "all" in policy_field_names or ip_net.prefixlen < prefix_mask:
        return False
    target_supernet = ip_net.supernet(new_prefix=prefix_mask)
    return any(net.prefixlen >= prefix_mask and net.overlaps(target_supernet) for obj_name in policy_field_names for net in addr_catalog.get(obj_name, []))

def port_matches_policy_field(proto, port, policy_svc_names, svc_catalog):
    if "ALL" in policy_svc_names:
        return True
    for s_name in policy_svc_names:
        s_data = svc_catalog.get(s_name)
        if s_data and (s_data["all"] or any(p_min <= port <= p_max for p_min, p_max in s_data.get(proto.lower(), []))):
            return True
    return False

def parse_requested_port(p_str):
    if "/" in p_str:
        proto, port = p_str.split("/", 1)
        return proto.lower(), int(port)
    return "tcp", int(p_str)

def analyze_traffic_request(adom, pkg, req_srcs, req_dsts, req_ports, tag_filter=None):
    fmg = FortiManagerAPI()
    fmg.login()

    try:
        policies = fmg.get_policies(adom, pkg)
        addr_catalog = build_address_resolver(fmg, adom)
        svc_catalog = build_service_resolver(fmg, adom)

        src_nets = [ipaddress.ip_network(s, strict=False) for s in req_srcs]
        dst_nets = [ipaddress.ip_network(d, strict=False) for d in req_dsts]
        parsed_ports = [parse_requested_port(p) for p in req_ports]

        print("\n======================================================================")
        print(" FASE 1: SIMULACIÓN SECUENCIAL TOP-DOWN (¿QUÉ REGLA HACE MATCH HOY?)")
        print("======================================================================")

        unpermitted_flows = []

        for s_net in src_nets:
            for d_net in dst_nets:
                for proto, port in parsed_ports:
                    matched_rule = None
                    for idx, pol in enumerate(policies):
                        if pol.get("status") == "disable":
                            continue
                        if (ip_matches_policy_field(s_net, as_list(pol.get("srcaddr")), addr_catalog) and
                            ip_matches_policy_field(d_net, as_list(pol.get("dstaddr")), addr_catalog) and
                            port_matches_policy_field(proto, port, as_list(pol.get("service")), svc_catalog)):
                            matched_rule = (idx + 1, pol)
                            break

                    flow_str = f"{s_net} -> {d_net} [{proto.upper()}/{port}]"
                    if matched_rule:
                        pos, r = matched_rule
                        action = r.get("action", "deny").upper()
                        pid = r.get("policyid")
                        rname = r.get("name", f"ID_{pid}")
                        if action == "ACCEPT":
                            print(f"  [PERMITIDO] {flow_str} ==> Match en Posición #{pos}: PolicyID {pid} ('{rname}')")
                        else:
                            print(f"  [BLOQUEADO] {flow_str} ==> DENY explícito en Posición #{pos}: PolicyID {pid} ('{rname}')")
                            unpermitted_flows.append((s_net, d_net, proto, port, pos))
                    else:
                        print(f"  [DENEGADO]  {flow_str} ==> Sin coincidencia (Cae en Implicit Deny final)")
                        unpermitted_flows.append((s_net, d_net, proto, port, len(policies) + 1))

        if not unpermitted_flows:
            print("\n[+] Todo el tráfico solicitado YA ESTÁ PERMITIDO por las políticas actuales.")
            return

        print("\n======================================================================")
        print(" FASE 2: BÚSQUEDA DE REGLAS CANDIDATAS PARA AMPLIAR / CONSOLIDAR")
        print("======================================================================")

        candidates = []

        for idx, pol in enumerate(policies):
            if pol.get("status") == "disable" or pol.get("action") != "accept":
                continue
            if tag_filter and tag_filter.lower() not in str(pol.get("global-label", "")).lower():
                continue

            pid = pol["policyid"]
            p_srcs = as_list(pol.get("srcaddr"))
            p_dsts = as_list(pol.get("dstaddr"))
            p_svcs = as_list(pol.get("service"))

            if "all" in p_srcs and "all" in p_dsts:
                continue

            src_exact = sum(1 for s in src_nets if ip_matches_policy_field(s, p_srcs, addr_catalog))
            src_subnet = sum(1 for s in src_nets if not ip_matches_policy_field(s, p_srcs, addr_catalog) and ip_shares_similar_subnet(s, p_srcs, addr_catalog))
            dst_exact = sum(1 for d in dst_nets if ip_matches_policy_field(d, p_dsts, addr_catalog))
            dst_subnet = sum(1 for d in dst_nets if not ip_matches_policy_field(d, p_dsts, addr_catalog) and ip_shares_similar_subnet(d, p_dsts, addr_catalog))
            port_exact = sum(1 for proto, port in parsed_ports if port_matches_policy_field(proto, port, p_svcs, svc_catalog))

            r_src = src_exact / len(src_nets)
            r_dst = dst_exact / len(dst_nets)
            r_port = port_exact / len(parsed_ports)
            r_dst_sim = (dst_exact + dst_subnet) / len(dst_nets)
            r_src_sim = (src_exact + src_subnet) / len(src_nets)

            reasons = []
            score = 0

            if r_port > 0 and (r_dst > 0 or r_dst_sim > 0):
                score += (r_port * 40) + (r_dst * 35) + ((r_dst_sim - r_dst) * 20) + (r_src * 25)
                if r_port == 1.0 and r_dst > 0:
                    reasons.append(f"Ya usa los mismos puertos ({port_exact}/{len(parsed_ports)}) hacia {dst_exact}/{len(dst_nets)} de los destinos")
                elif r_port > 0 and dst_subnet > 0:
                    reasons.append(f"Ya abre esos puertos hacia servidores de la misma subred /24 que tus destinos ({dst_subnet} coincidencias)")

            if r_src > 0 and r_port > 0:
                score = max(score, (r_src * 45) + (r_port * 40) + (r_dst * 15))
                reasons.append(f"Ya incluye {src_exact}/{len(src_nets)} orígenes y {port_exact}/{len(parsed_ports)} puertos solicitados")

            if (r_src > 0 or r_src_sim > 0) and (r_dst > 0 or r_dst_sim > 0) and r_port < 1.0:
                score = max(score, (r_src * 45) + (r_dst * 45) + (r_port * 10))
                reasons.append(f"Ya comunica orígenes ({src_exact}/{len(src_nets)}) con destinos ({dst_exact}/{len(dst_nets)}) en otros puertos")

            if score < 35:
                continue

            missing_srcs = [str(s) for s in src_nets if not ip_matches_policy_field(s, p_srcs, addr_catalog)]
            missing_dsts = [str(d) for d in dst_nets if not ip_matches_policy_field(d, p_dsts, addr_catalog)]
            missing_ports = [f"{pr.upper()}/{po}" for pr, po in parsed_ports if not port_matches_policy_field(pr, po, p_svcs, svc_catalog)]
            blocked_above = any((idx + 1) > deny_pos for _, _, _, _, deny_pos in unpermitted_flows)

            candidates.append({
                "pos": idx + 1, "id": pid, "name": pol.get("name", f"ID_{pid}"),
                "score": round(min(score, 99.0), 1), "srcintf": as_list(pol.get("srcintf")),
                "dstintf": as_list(pol.get("dstintf")), "reasons": list(dict.fromkeys(reasons)),
                "missing_src": missing_srcs, "missing_dst": missing_dsts,
                "missing_port": missing_ports, "blocked_above": blocked_above
            })

        candidates.sort(key=lambda x: x["score"], reverse=True)

        if not candidates:
            print("  [-] No se encontraron políticas candidatas con afinidad suficiente. Se recomienda crear una regla nueva.")
            return

        for c in candidates[:8]:
            warn = " [¡ATENCIÓN: Hay una regla DENY por encima de esta posición!]" if c["blocked_above"] else ""
            print(f"\n  ★ CANDIDATA PolicyID {c['id']} ('{c['name']}') | Posición #{c['pos']} | Afinidad: {c['score']}%{warn}")
            print(f"    Interfaces : {c['srcintf']} -> {c['dstintf']}")
            print(f"    Motivos    : {' | '.join(c['reasons'])}")
            acciones = []
            if c["missing_src"]:
                acciones.append(f"Añadir a srcaddr: {c['missing_src']}")
            if c["missing_dst"]:
                acciones.append(f"Añadir a dstaddr: {c['missing_dst']}")
            if c["missing_port"]:
                acciones.append(f"Añadir a service: {c['missing_port']}")
            print(f"    Cambio req.: {' ; '.join(acciones)}")
    finally:
        fmg.logout()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Busca políticas que permiten/deniegan un tráfico y sugiere reglas candidatas para ampliar")
    parser.add_argument("--adom", required=True, help="Nombre del ADOM")
    parser.add_argument("--pkg", required=True, help="Nombre del Policy Package")
    parser.add_argument("--src", nargs="+", required=True, help="IPs o subredes origen (ej. 10.10.1.15 10.10.2.0/24)")
    parser.add_argument("--dst", nargs="+", required=True, help="IPs o subredes destino (ej. 192.168.50.10 192.168.50.12)")
    parser.add_argument("--ports", nargs="+", required=True, help="Puertos requeridos (ej. tcp/443 tcp/8443 udp/53)")
    parser.add_argument("--tag", help="Filtrar candidatas por Policy Tag / Global Label")
    args = parser.parse_args()
    analyze_traffic_request(args.adom, args.pkg, args.src, args.dst, args.ports, args.tag)
