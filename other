### 5.1. Módulo Base F5: `f5_client.py`
Gestiona el token `X-F5-Auth-Token` en `/mgmt/shared/authn/login`, los snapshots locales en `./backups_f5/` y la ejecución de la tarea obligatoria `apply-policy` tras cada cambio.

```python
# f5_client.py
import os
import json
import time
import urllib3
import requests
from datetime import datetime

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

F5_HOST = os.getenv("F5_HOST", "10.0.0.20")
F5_USER = os.getenv("F5_USER", "admin")
F5_PASS = os.getenv("F5_PASS", "tu_password")

class F5AsmClient:
    def __init__(self):
        self.base_url = f"https://{F5_HOST}/mgmt"
        self.session = requests.Session()
        self.session.verify = False
        self.token = None
        self._login()

    def _login(self):
        url = f"{self.base_url}/shared/authn/login"
        payload = {"username": F5_USER, "password": F5_PASS, "loginProviderName": "tmos"}
        r = self.session.post(url, json=payload, timeout=30)
        r.raise_for_status()
        self.token = r.json()["token"]["token"]
        self.session.headers.update({"X-F5-Auth-Token": self.token, "Content-Type": "application/json"})

    def get(self, endpoint, params=None):
        r = self.session.get(f"{self.base_url}/{endpoint.lstrip('/')}", params=params, timeout=60)
        r.raise_for_status()
        return r.json()

    def post(self, endpoint, data):
        r = self.session.post(f"{self.base_url}/{endpoint.lstrip('/')}", json=data, timeout=60)
        r.raise_for_status()
        return r.json()

    def patch(self, endpoint, data):
        r = self.session.patch(f"{self.base_url}/{endpoint.lstrip('/')}", json=data, timeout=60)
        r.raise_for_status()
        return r.json()

    def get_policies(self, name_filter=None):
        items = self.get("tm/asm/policies").get("items", [])
        if name_filter:
            return [p for p in items if name_filter.lower() in p["name"].lower()]
        return items

    def backup_policy_summary(self, policy_id, policy_name):
        os.makedirs("backups_f5", exist_ok=True)
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        pol_data = self.get(f"tm/asm/policies/{policy_id}")
        sigs_overridden = self.get(
            f"tm/asm/policies/{policy_id}/signatures",
            params={"$filter": "performStaging eq false or enabled eq false", "$select": "id,signature/signatureId,enabled,performStaging"}
        ).get("items", [])
        w_ips = self.get(f"tm/asm/policies/{policy_id}/whitelist-ips").get("items", [])

        snapshot = {"policy": pol_data, "signature_states": sigs_overridden, "whitelist_ips": w_ips}
        safe_name = policy_name.replace("/", "_")
        fname = f"backups_f5/{safe_name}_{ts}.json"
        with open(fname, "w", encoding="utf-8") as f:
            json.dump(snapshot, f, indent=2)
        return fname

    def apply_policy(self, policy_id, policy_name):
        task = self.post("tm/asm/tasks/apply-policy", {
            "policyReference": {"link": f"https://localhost/mgmt/tm/asm/policies/{policy_id}"}
        })
        task_id = task["id"]
        for _ in range(30):
            status = self.get(f"tm/asm/tasks/apply-policy/{task_id}").get("status")
            if status == "COMPLETED":
                print(f"  [+] Apply Policy completado en '{policy_name}'")
                return True
            if status == "FAILURE":
                print(f"  [!] Fallo al aplicar política en '{policy_name}'")
                return False
            time.sleep(2)
        return False
```

