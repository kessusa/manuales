# f5_03_enforce_signatures.py
import argparse
from f5_client import F5AsmClient

def manage_f5_enforcement(sig_ids=None, sig_sets=None, global_mode=None, staging=False, disable=False, policy_filter=None, dry_run=False):
    f5 = F5AsmClient()
    policies = f5.get_policies(policy_filter)
    target_sigs = [str(s) for s in (sig_ids or [])]
    target_sets = [s.lower() for s in (sig_sets or [])]

    for p in policies:
        pid = p["id"]
        pname = p["fullPath"]
        changed = False

        if not dry_run:
            bkp = f5.backup_policy_summary(pid, p["name"])
            print(f"[*] Backup previo guardado en {bkp}")

        if global_mode:
            if dry_run:
                print(f"[DRY-RUN] '{pname}' pasaría a enforcementMode={global_mode}")
            else:
                f5.patch(f"tm/asm/policies/{pid}", {"enforcementMode": global_mode})
                changed = True

        if target_sets:
            sets_in_pol = f5.get(f"tm/asm/policies/{pid}/signature-sets").get("items", [])
            for ss in sets_in_pol:
                ss_name = ss.get("signatureSetReference", {}).get("name", "")
                if any(t in ss_name.lower() for t in target_sets):
                    if dry_run:
                        print(f"[DRY-RUN] '{pname}' -> Signature Set '{ss_name}' block={not staging}")
                    else:
                        f5.patch(f"tm/asm/policies/{pid}/signature-sets/{ss['id']}", {"block": not staging, "alarm": True})
                        changed = True

        for pub_sig_id in target_sigs:
            found = f5.get(
                f"tm/asm/policies/{pid}/signatures",
                params={"$filter": f"signature/signatureId eq {pub_sig_id}"}
            ).get("items", [])
            if not found:
                print(f"  [-] Firma {pub_sig_id} no encontrada en '{pname}'")
                continue

            internal_sig_id = found[0]["id"]
            payload = {"enabled": not disable, "performStaging": staging}
            if dry_run:
                print(f"[DRY-RUN] '{pname}' -> Firma {pub_sig_id} actualizaría a {payload}")
            else:
                f5.patch(f"tm/asm/policies/{pid}/signatures/{internal_sig_id}", payload)
                print(f"  [+] '{pname}' -> Firma {pub_sig_id} actualizada: Enabled={not disable}, Staging={staging}")
                changed = True

        if changed and not dry_run:
            f5.apply_policy(pid, pname)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Pasa firmas, Signature Sets o políticas F5 ASM a Enforcement (Blocking)")
    parser.add_argument("--sigs", nargs="+", help="IDs públicos de firmas ASM (ej. 200001475 200004123)")
    parser.add_argument("--sets", nargs="+", help="Nombres de Signature Sets (ej. 'SQL Injection' 'Command Execution')")
    parser.add_argument("--policy-mode", choices=["blocking", "transparent"], help="Cambiar el modo global de la política")
    parser.add_argument("--staging", action="store_true", help="Poner en modo Staging (Detection) en lugar de Enforcement")
    parser.add_argument("--disable", action="store_true", help="Deshabilitar las firmas indicadas")
    parser.add_argument("--filter", help="Filtrar por nombre de política")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    manage_f5_enforcement(args.sigs, args.sets, args.policy_mode, args.staging, args.disable, args.filter, args.dry_run)
```

