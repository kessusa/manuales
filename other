def update_akamai_enforcement(config_id, policy_id=None, groups=None, rules=None, rate_policy_ids=None, action="deny", dry_run=False):
    ak = AkamaiAppSecClient()

    if dry_run:
        cfg = ak.get(f"/appsec/v1/configs/{config_id}")
