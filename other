## 7. Bloque 4: Fortinet FortiManager (Firewall Hygiene & Finder)

### 7.1. Módulo Base FortiManager: `fmg_client.py`
Gestiona sesiones JSON-RPC, soporte de API Token, bloqueo y commit de ADOM (`_workspace/lock`, `commit`, `unlock`) y copias de seguridad locales en `./fmg_backups/`.

```python
# fmg_client.py
import os
import json
import requests
import urllib3
from datetime import datetime

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

FMG_HOST = os.getenv("FMG_HOST", "10.0.0.50")
FMG_USER = os.getenv("FMG_USER", "admin")
FMG_PASS = os.getenv("FMG_PASS", "tu_password")
FMG_TOKEN = os.getenv("FMG_TOKEN", "")

class FortiManagerAPI:
    def __init__(self):
        self.url = f"https://{FMG_HOST}/jsonrpc"
        self.session = requests.Session()
        self.session.verify = False
        self.token = None
        self.req_id = 1

    def _call(self, method, params):
        payload = {"id": self.req_id, "method": method, "params": params}
        if self.token and not FMG_TOKEN:
            payload["session"] = self.token
        headers = {"Content-Type": "application/json"}
        if FMG_TOKEN:
            headers["Authorization"] = f"Bearer {FMG_TOKEN}"

        self.req_id += 1
        resp = self.session.post(self.url, json=payload, headers=headers, timeout=60)
        resp.raise_for_status()
        data = resp.json()
        res = data.get("result", [{}])[0]
        if res.get("status", {}).get("code", -1) != 0:
            raise RuntimeError(f"Error FMG API: {res.get('status')}")
        return res.get("data")

    def login(self):
        if FMG_TOKEN:
            return
        payload = {"id": 1, "method": "exec", "params": [{"url": "/sys/login/user", "data": {"user": FMG_USER, "passwd": FMG_PASS}}]}
        r = self.session.post(self.url, json=payload, verify=False).json()
        self.token = r.get("session")

    def logout(self):
        if self.token and not FMG_TOKEN:
            self._call("exec", [{"url": "/sys/logout"}])

    def lock_adom(self, adom):
        try:
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/lock"}])
        except RuntimeError:
            pass

    def commit_and_unlock(self, adom):
        try:
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/commit"}])
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/unlock"}])
        except RuntimeError:
            pass

    def get_policies(self, adom, pkg):
        url = f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy"
        return self._call("get", [{"url": url}]) or []

def backup_package(adom, pkg, policies):
    os.makedirs("fmg_backups", exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    fname = f"fmg_backups/{adom}_{pkg}_{ts}.json"
    with open(fname, "w", encoding="utf-8") as f:
        json.dump(policies, f, indent=2)
    return fname
```

