### 7.2. Limpieza de Reglas sin Uso (`0 Hits` / Inactivas): `fmg_01_clean_unused_rules.py`
* **Qué hace:** Detecta políticas con `0 hits` o sin uso durante más de `--days` días y las deshabilita (documentando la fecha en `comments`) o elimina.
* **Argumentos:** `--adom`, `--pkg`, `--tag`, `--days`, `--action [disable|delete]`, `--dry-run`.

```python
# fmg_01_clean_unused_rules.py
import argparse
import time
from datetime import datetime
from fmg_client import FortiManagerAPI, backup_package

def clean_unused_policies(adom, pkg, tag_filter=None, unused_days=90, action="disable", dry_run=False):
    fmg = FortiManagerAPI()
    fmg.login()

    try:
        policies = fmg.get_policies(adom, pkg)
        print(f"[*] Total de políticas en '{adom}/{pkg}': {len(policies)}")
        backup_file = backup_package(adom, pkg, policies)
        print(f"[+] Backup guardado en: {backup_file}")

        now_ts = int(time.time())
        cutoff_seconds = unused_days * 86400
        candidates = []

        for pol in policies:
            pid = pol.get("policyid")
            status = pol.get("status", "enable")
            label = pol.get("global-label", "")
            comments = pol.get("comments", "") or ""

            if tag_filter and tag_filter.lower() not in str(label).lower() and tag_filter.lower() not in comments.lower():
                continue
            if action == "disable" and status == "disable":
                continue

            hits = int(pol.get("_hitcount", pol.get("hit-count", 0)) or 0)
            last_used = int(pol.get("_last_used", pol.get("last-used", 0)) or 0)

            if hits == 0:
                candidates.append((pol, "0 Hits totales"))
            elif last_used > 0 and (now_ts - last_used) > cutoff_seconds:
                days_ago = (now_ts - last_used) // 86400
                candidates.append((pol, f"Sin tráfico hace {days_ago} días (> {unused_days}d)"))

        print(f"[*] Detectadas {len(candidates)} reglas sin uso.")
        if dry_run or not candidates:
            for pol, reason in candidates:
                print(f"  [DRY-RUN] PolicyID {pol['policyid']} ({pol.get('name')}) -> Acción: {action.upper()} | Motivo: {reason}")
            return

        fmg.lock_adom(adom)
        today = datetime.now().strftime("%Y-%m-%d")

        for pol, reason in candidates:
            pid = pol["policyid"]
            pol_url = f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy/{pid}"

            if action == "disable":
                old_comment = pol.get("comments", "") or ""
                new_comment = f"{old_comment} [AUTO-DISABLED {today}: {reason}]".strip()
                fmg._call("update", [{"url": pol_url, "data": {"status": "disable", "comments": new_comment}}])
                print(f"[+] PolicyID {pid} DESHABILITADA ({reason})")
            elif action == "delete":
                fmg._call("delete", [{"url": pol_url}])
                print(f"[-] PolicyID {pid} ELIMINADA ({reason})")

        fmg.commit_and_unlock(adom)
    finally:
        fmg.logout()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Deshabilita o elimina políticas sin uso en FortiManager")
    parser.add_argument("--adom", required=True, help="Nombre del ADOM")
    parser.add_argument("--pkg", required=True, help="Nombre del Policy Package")
    parser.add_argument("--tag", help="Filtrar por Policy Tag / Global Label o comentario")
    parser.add_argument("--days", type=int, default=90, help="Días sin uso para considerar inactiva (default: 90)")
    parser.add_argument("--action", choices=["disable", "delete"], default="disable")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    clean_unused_policies(args.adom, args.pkg, args.tag, args.days, args.action, args.dry_run)
