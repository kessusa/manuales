### 7.3. Detección de Reglas en Sombra (Shadowed): `fmg_02_detect_shadow_rules.py`
* **Qué hace:** Compara matemáticamente subredes CIDR, interfaces, servicios y horarios de arriba abajo para identificar reglas 100% solapadas por una regla superior, distinguiendo entre **Sombras Redundantes** y **Conflictos de Acción**.
* **Argumentos:** `--adom`, `--pkg`, `--disable-redundant`.

```python
# fmg_02_detect_shadow_rules.py
import argparse
import ipaddress
from fmg_client import FortiManagerAPI

def as_set(val):
    if isinstance(val, list):
        return set(val)
    return {val} if val else set()

def load_address_subnets(fmg, adom):
    objs = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/address"}]) or []
    addr_map = {"all": [ipaddress.ip_network("0.0.0.0/0")]}
    for o in objs:
        name = o.get("name")
        subnet = o.get("subnet")
        if isinstance(subnet, list) and len(subnet) == 2:
            try:
                net = ipaddress.ip_network(f"{subnet[0]}/{subnet[1]}", strict=False)
                addr_map[name] = [net]
            except ValueError:
                pass
    return addr_map

def is_addr_subset(sub_names, super_names, addr_map):
    if "all" in super_names or sub_names.issubset(super_names):
        return True
    sub_nets = [net for name in sub_names for net in addr_map.get(name, [])]
    super_nets = [net for name in super_names for net in addr_map.get(name, [])]
    if not sub_nets or not super_nets:
        return False
    return all(any(sub_n.subnet_of(sup_n) for sup_n in super_nets) for sub_n in sub_nets)

def is_field_subset(sub_set, super_set, wildcard):
    return wildcard in super_set or sub_set.issubset(super_set)

def find_shadowed_policies(adom, pkg, remove_redundant=False):
    fmg = FortiManagerAPI()
    fmg.login()

    try:
        policies = fmg.get_policies(adom, pkg)
        addr_map = load_address_subnets(fmg, adom)
        active_upper_rules = []
        shadowed_found = []

        for pol in policies:
            if pol.get("status") == "disable":
                continue

            pid = pol["policyid"]
            p_srcintf = as_set(pol.get("srcintf"))
            p_dstintf = as_set(pol.get("dstintf"))
            p_srcaddr = as_set(pol.get("srcaddr"))
            p_dstaddr = as_set(pol.get("dstaddr"))
            p_svc = as_set(pol.get("service"))
            p_sched = as_set(pol.get("schedule"))

            for upper in active_upper_rules:
                if (is_field_subset(p_srcintf, upper["srcintf"], "any") and
                    is_field_subset(p_dstintf, upper["dstintf"], "any") and
                    is_addr_subset(p_srcaddr, upper["srcaddr"], addr_map) and
                    is_addr_subset(p_dstaddr, upper["dstaddr"], addr_map) and
                    is_field_subset(p_svc, upper["service"], "ALL") and
                    is_field_subset(p_sched, upper["schedule"], "always")):

                    same_action = (pol.get("action") == upper["raw"].get("action"))
                    shadow_type = "REDUNDANTE (Misma acción)" if same_action else "CONFLICTO (Acción opuesta oculta)"
                    shadowed_found.append({
                        "shadowed_id": pid,
                        "shadowed_name": pol.get("name"),
                        "by_id": upper["id"],
                        "by_name": upper["raw"].get("name"),
                        "type": shadow_type,
                        "same_action": same_action
                    })
                    break

            active_upper_rules.append({
                "id": pid, "srcintf": p_srcintf, "dstintf": p_dstintf,
                "srcaddr": p_srcaddr, "dstaddr": p_dstaddr,
                "service": p_svc, "schedule": p_sched, "raw": pol
            })

        print(f"[*] Detectadas {len(shadowed_found)} reglas en sombra (Shadowed):")
        for s in shadowed_found:
            print(f"  • PolicyID {s['shadowed_id']} ({s['shadowed_name']}) está tapada por PolicyID {s['by_id']} ({s['by_name']}) -> [{s['type']}]")

        if remove_redundant and shadowed_found:
            fmg.lock_adom(adom)
            for s in shadowed_found:
                if s["same_action"]:
                    url = f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy/{s['shadowed_id']}"
                    fmg._call("update", [{"url": url, "data": {"status": "disable"}}])
                    print(f"[+] PolicyID {s['shadowed_id']} deshabilitada por ser 100% redundante.")
            fmg.commit_and_unlock(adom)
    finally:
        fmg.logout()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Detecta reglas en sombra (Shadowed) en FortiManager")
    parser.add_argument("--adom", required=True)
    parser.add_argument("--pkg", required=True)
    parser.add_argument("--disable-redundant", action="store_true", help="Deshabilita automáticamente las sombras redundantes")
    args = parser.parse_args()
    find_shadowed_policies(args.adom, args.pkg, remove_redundant=args.disable_redundant)
```

