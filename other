def audit_f5_policies(policy_filter=None, details=False):
    f5 = F5AsmClient()
    policies = f5.get_policies(policy_filter)

    for p in policies:
        pid = p["id"]
        print(f"\n======================================================================")
        print(f"POLÍTICA ASM: {p['fullPath']} (ID: {pid})")
