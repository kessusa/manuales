### 5.5. Creación de Excepciones (URL / Parámetro / IP Whitelist): `f5_04_exceptions_and_patching.py`
* **Qué hace:** Excluye un `signatureId` sobre un parámetro concreto (`--param`) o sobre una URL (`--url`), o añade una IP a la lista blanca (`--whitelist-ip`), aplicando la política automáticamente.
* **Argumentos:** `--filter`, `--sig <id>`, `--param <nombre>`, `--url <path>`, `--whitelist-ip <ip>`, `--dry-run`.

```python
# f5_04_exceptions_and_patching.py
import argparse
from f5_client import F5AsmClient

def add_f5_exception(policy_filter, sig_id=None, param_name=None, url_path=None, whitelist_ip=None, netmask="255.255.255.255", dry_run=False):
    f5 = F5AsmClient()
    policies = f5.get_policies(policy_filter)

    for p in policies:
        pid = p["id"]
        pname = p["fullPath"]

        if whitelist_ip:
            if dry_run:
                print(f"[DRY-RUN] Añadiría IP {whitelist_ip}/{netmask} a Whitelist en '{pname}'")
            else:
                f5.post(f"tm/asm/policies/{pid}/whitelist-ips", {
                    "ipAddress": whitelist_ip,
                    "ipMask": netmask,
                    "neverBlockRequests": True,
                    "description": "Added via SecOps Automation"
                })
                f5.apply_policy(pid, pname)

        if sig_id and (param_name or url_path):
            global_sig = f5.get("tm/asm/signatures", params={"$filter": f"signatureId eq {sig_id}"}).get("items", [])
            if not global_sig:
                print(f"[!] No existe la firma global {sig_id} en el F5.")
                return
            sig_link = global_sig[0]["selfLink"]

            if param_name:
                if dry_run:
                    print(f"[DRY-RUN] Excluiría firma {sig_id} del parámetro '{param_name}' en '{pname}'")
                else:
                    existing_p = f5.get(f"tm/asm/policies/{pid}/parameters", params={"$filter": f"name eq '{param_name}'"}).get("items", [])
                    if existing_p:
                        param_id = existing_p[0]["id"]
                    else:
                        created = f5.post(f"tm/asm/policies/{pid}/parameters", {"name": param_name, "level": "global", "performStaging": False})
                        param_id = created["id"]

                    f5.post(f"tm/asm/policies/{pid}/parameters/{param_id}/signature-overrides", {
                        "enabled": False,
                        "signatureReference": {"link": sig_link}
                    })
                    print(f"[+] Excepción creada: Firma {sig_id} desactivada en parámetro '{param_name}' ({pname})")
                    f5.apply_policy(pid, pname)

            if url_path:
                if dry_run:
                    print(f"[DRY-RUN] Excluiría firma {sig_id} de la URL '{url_path}' en '{pname}'")
                else:
                    existing_u = f5.get(f"tm/asm/policies/{pid}/urls", params={"$filter": f"name eq '{url_path}'"}).get("items", [])
                    if existing_u:
                        url_id = existing_u[0]["id"]
                    else:
                        created_u = f5.post(f"tm/asm/policies/{pid}/urls", {"name": url_path, "protocol": "https", "performStaging": False})
                        url_id = created_u["id"]

                    f5.post(f"tm/asm/policies/{pid}/urls/{url_id}/signature-overrides", {
                        "enabled": False,
                        "signatureReference": {"link": sig_link}
                    })
                    print(f"[+] Excepción creada: Firma {sig_id} desactivada en URL '{url_path}' ({pname})")
                    f5.apply_policy(pid, pname)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Crea excepciones de falsos positivos (URL, Parámetro, IP) en F5 ASM")
    parser.add_argument("--filter", help="Filtrar por nombre de política ASM")
    parser.add_argument("--sig", type=int, help="ID público de la firma a excluir (ej. 200001475)")
    parser.add_argument("--param", help="Nombre del parámetro donde excluir la firma (ej. xml_payload)")
    parser.add_argument("--url", help="Ruta URL donde excluir la firma (ej. /api/v1/login)")
    parser.add_argument("--whitelist-ip", help="IP origen a meter en lista blanca")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    add_f5_exception(args.filter, args.sig, args.param, args.url, args.whitelist_ip, dry_run=args.dry_run)
