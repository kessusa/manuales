"""
WAF Section - LLM use case: AI analysis of AVI iWAF logs.

Use case pattern (same for every new LLM use case):
    - prompts live in module constants
    - the LlmApi instance is injected, never created here
    - only llm.ask_json() / llm.ask() / llm.chat() are used
    - every function returns data or None, errors are logged

    from API_cnx.llm_api import LlmApi
    from API_cnx.llm_waf_usecase import waf_llm_report

    output_file, summary = waf_llm_report(input_file, LlmApi())
"""
import hashlib
import json
import logging
import os
import re
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime

import pandas as pd

from API_cnx.llm_api import NO_THINK
from bookmark.settings import MEDIA_ROOT

logger = logging.getLogger(__name__)

OUTPUT_DIR = f'{MEDIA_ROOT}/avi_iwaf'
WORKERS = 4
MAX_RETRIES = 3
DEFAULT_BATCH_SIZE = 5
MAX_TOKENS = 4000
PAYLOAD_TRUNC = 300
SAMPLE_SIZE = 3
REDUCE_VERDICTS = 100
DEFAULT_CLEANUP_THRESHOLD = 10.0
SCORE_COLUMN = 'Abuse Confidence Score'
COUNT_COLUMN = 'Count'
IP_COLUMN = 'ip'
IP_COLUMN_CANDIDATES = ('ip', 'original_client_ip', 'client_ip')
DEFAULT_SIGNATURE_COLUMNS = [
    'waf.rule.id', 'url.path', 'avi.waf_log.rule_logs.matches.match_element',
]
DEFAULT_CONTEXT_COLUMNS = ['ip', 'waf.rule.match_value']
# Identifier columns: part of the signature as they are, never normalized
RAW_SIGNATURE_COLUMNS = ('waf.rule.id',)

# Signatures per LLM call. No streaming in the connector, so keep every
# generation short enough to finish before the gateway timeout.
MODEL_BATCH = {
    'llama3.3-70b': 8,
    'gpt-oss-120b': 6,
    'gemma-4-31b': 4,
    'qwen3.8-27b-ITG': 6,
}
# Models that only disable thinking with reasoning_effort=NO_THINK
NO_THINK_MODELS = ('qwen3.8-27b-ITG',)

CLASSIFICATIONS = ('attack', 'false_positive', 'benign', 'unknown')
ANALYSIS_DEFAULTS = {
    'classification': 'unknown',
    'attack_confidence': 0,
    'false_positive_confidence': 0,
    'risk_level': 'unknown',
    'attack_type': '',
    'security_expert_analysis': '',
    'evidence_from_log': '',
    'why_it_may_be_false_positive': '',
    'production_impact': '',
    'recommended_action': '',
    'aviwaf_exception_type': '',
    'aviwaf_exception_scope': '',
    'aviwaf_exception_example': '',
    'safe_to_bypass': False,
    'code_fix_recommendation': '',
    'needs_manual_review': False,
}

SYSTEM_PROMPT = """ROLE
You are a senior cybersecurity analyst specialized in ModSecurity CRS,
AVI/NSX ALB WAF logs and production web application security.

OBJECTIVE
Analyze WAF event signatures. Distinguish real attacks from false positives.
Decide what should be blocked, monitored, or safely bypassed.

OUTPUT FORMAT
Return ONLY a valid JSON array. No markdown, no comments.
One object per input signature, with EXACTLY these fields:
{
  "signature_id": "<copy from input>",
  "classification": "attack | false_positive | benign | unknown",
  "attack_confidence": 0,
  "false_positive_confidence": 0,
  "risk_level": "low | medium | high | critical",
  "attack_type": "sqli | xss | rce | lfi | rfi | path_traversal | scanner | bot | protocol_violation | command_injection | file_upload | auth_attack | data_exfiltration | unknown | none",
  "security_expert_analysis": "",
  "evidence_from_log": "",
  "why_it_may_be_false_positive": "",
  "production_impact": "",
  "recommended_action": "allow | block | monitor | investigate | patch",
  "aviwaf_exception_type": "url | parameter | cookie | header | rule | none",
  "aviwaf_exception_scope": "global | path-specific | client-specific | none",
  "aviwaf_exception_example": "",
  "safe_to_bypass": false,
  "code_fix_recommendation": "",
  "needs_manual_review": false
}
Keep free-text fields under 25 words."""

REDUCE_PROMPT = 'Produce ONLY a valid JSON summary of these WAF statistics and verdicts.'
RETRY_FEEDBACK = '\n\nYour previous answer was not valid JSON. Return ONLY the JSON.'


# ---------------------------------------------------------------------------
# Dataset preparation (no LLM)
# ---------------------------------------------------------------------------
def load_waf_export(input_file):
    """Load the AVI visual search export (xlsx / csv) with a normalized ip column."""
    if str(input_file).lower().endswith('.csv'):
        df = pd.read_csv(input_file)
    else:
        df = pd.read_excel(input_file)

    # AVI visual search headers come as 'waf.rule.id: Descending'
    df.columns = [str(column).split(':')[0].strip() for column in df.columns]
    ip_column = next((column for column in IP_COLUMN_CANDIDATES if column in df.columns), df.columns[0])
    return df.rename(columns={ip_column: IP_COLUMN})


def normalize_payload(value):
    """Collapse variable parts so equivalent events share one signature."""
    text = '' if pd.isnull(value) else str(value).strip()
    if text.startswith('/'):
        text = text.split('?', 1)[0]
    text = re.sub(r'\b[0-9a-f]{8,}\b', '<hex>', text, flags=re.IGNORECASE)
    text = re.sub(r'\d+', '<n>', text)
    if ',' in text:
        parts = sorted({part.strip() for part in text.split(',') if part.strip()})
        text = ','.join(parts[:3])
    return text[:PAYLOAD_TRUNC]


def build_signatures(df, signature_columns, context_columns, count_column=COUNT_COLUMN):
    """
    Add signature_id to df and return (df, signatures).
    signatures = {signature_id: payload sent to the LLM}
    """
    df = df.copy()
    signature_columns = [column for column in signature_columns if column in df.columns]
    context_columns = [column for column in context_columns if column in df.columns]
    if not signature_columns:
        logger.error(f'WAF LLM: no signature column found in the export. Columns: {list(df.columns)}')
        return df, None

    # Normalize once per unique value instead of once per row
    key = pd.Series('', index=df.index)
    for column in signature_columns:
        if column in RAW_SIGNATURE_COLUMNS:
            key = key + '|' + df[column].astype(str)
            continue
        mapping = {value: normalize_payload(value) for value in df[column].unique()}
        key = key + '|' + df[column].map(mapping)
    df['signature_id'] = key.map(lambda text: hashlib.md5(text.encode('utf-8')).hexdigest()[:12])

    signatures = {}
    for signature_id, group in df.groupby('signature_id', sort=False):
        first_row = group.iloc[0]
        signature = {
            'signature_id': signature_id,
            'occurrences': int(group[count_column].sum()) if count_column in group.columns else len(group),
        }
        for column in signature_columns:
            signature[column] = str(first_row[column])[:PAYLOAD_TRUNC]
        for column in context_columns:
            values = group[column].dropna().astype(str).unique()[:SAMPLE_SIZE]
            signature[f'{column}_sample'] = [value[:PAYLOAD_TRUNC] for value in values]
        signatures[signature_id] = signature
    return df, signatures


def annotate_pruned(df_pruned, threshold):
    """Rows over the AbuseIPDB threshold get an automated verdict, no LLM call."""
    df_pruned = df_pruned.copy()
    for field, default in ANALYSIS_DEFAULTS.items():
        df_pruned[field] = default
    df_pruned['signature_id'] = ''
    df_pruned['classification'] = 'attack'
    df_pruned['attack_confidence'] = 100
    df_pruned['risk_level'] = 'high'
    df_pruned['recommended_action'] = 'block'
    df_pruned['security_expert_analysis'] = (
        f'Automated verdict: AbuseIPDB score >= {threshold}. LLM was NOT used for this row.'
    )
    return df_pruned


# ---------------------------------------------------------------------------
# LLM steps
# ---------------------------------------------------------------------------
def get_model_options(llm, model):
    """Return (batch_size, extra ask_json kwargs) for the resolved model."""
    model_name = llm.get_model(model)
    options = {'max_tokens': MAX_TOKENS}
    if model_name in NO_THINK_MODELS:
        options['reasoning_effort'] = NO_THINK
    return MODEL_BATCH.get(model_name, DEFAULT_BATCH_SIZE), options


def clean_verdict(entry):
    """Keep only the known fields, with safe defaults."""
    verdict = {'signature_id': entry['signature_id']}
    for field, default in ANALYSIS_DEFAULTS.items():
        value = entry.get(field, default)
        verdict[field] = default if value is None else value
    if verdict['classification'] not in CLASSIFICATIONS:
        verdict['classification'] = 'unknown'
        verdict['needs_manual_review'] = True
    return verdict


def manual_review_verdict(signature_id):
    verdict = dict(ANALYSIS_DEFAULTS, signature_id=signature_id, needs_manual_review=True)
    verdict['security_expert_analysis'] = 'LLM analysis failed. Manual review required.'
    return verdict


def ask_json_with_retries(llm, system, prompt, model, options, retries=MAX_RETRIES):
    """Call the LLM until it returns valid JSON. Returns None after `retries` failures."""
    for attempt in range(1, retries + 1):
        result = llm.ask_json(prompt, system=system, model=model, **options)
        if result is not None:
            return result
        prompt += RETRY_FEEDBACK
        time.sleep(2 * attempt)
    logger.error(f'WAF LLM: no valid JSON after {retries} attempts')
    return None


def analyze_batch(llm, batch, model, options):
    """One LLM call. Returns {signature_id: verdict} with the valid answers only."""
    expected_ids = {signature['signature_id'] for signature in batch}
    prompt = f'SIGNATURES\n{json.dumps(batch, ensure_ascii=False, indent=1, default=str)}'
    result = ask_json_with_retries(llm, SYSTEM_PROMPT, prompt, model, options)

    if isinstance(result, dict):
        result = result.get('results') or [result]
    if not isinstance(result, list):
        return {}
    return {
        entry['signature_id']: clean_verdict(entry)
        for entry in result
        if isinstance(entry, dict) and entry.get('signature_id') in expected_ids
    }


def run_batches(llm, batches, model, options, verdicts, checkpoint_path):
    """Run the batches in parallel, saving the checkpoint as they finish."""
    with ThreadPoolExecutor(max_workers=WORKERS) as executor:
        futures = [executor.submit(analyze_batch, llm, batch, model, options) for batch in batches]
        for future in as_completed(futures):
            try:
                verdicts.update(future.result())
            except Exception as error:
                logger.error(f'WAF LLM batch error: {error}')
            save_checkpoint(checkpoint_path, verdicts)
            logger.info(f'WAF LLM progress: {len(verdicts)} signatures analyzed')


def analyze_signatures(llm, signatures, checkpoint_path, model='default', batch_size=None):
    """
    Return {signature_id: verdict} for every signature.
    Parallel batches -> failed signatures retried one by one -> manual review fallback.
    """
    default_batch_size, options = get_model_options(llm, model)
    batch_size = batch_size or default_batch_size
    verdicts = load_checkpoint(checkpoint_path)

    pending = [signature for signature_id, signature in signatures.items() if signature_id not in verdicts]
    batches = [pending[index:index + batch_size] for index in range(0, len(pending), batch_size)]
    run_batches(llm, batches, model, options, verdicts, checkpoint_path)

    failed = [[signature] for signature in pending if signature['signature_id'] not in verdicts]
    if failed:
        logger.warning(f'WAF LLM: retrying {len(failed)} signatures individually')
        run_batches(llm, failed, model, options, verdicts, checkpoint_path)

    for signature_id in signatures:
        if signature_id not in verdicts:
            verdicts[signature_id] = manual_review_verdict(signature_id)
    return {signature_id: verdicts[signature_id] for signature_id in signatures}


def build_dataset_stats(df, verdicts, count_column=COUNT_COLUMN):
    """Statistics weighted by the Count column over the full dataset."""
    weight = df[count_column] if count_column in df.columns else pd.Series(1, index=df.index)
    weight = pd.to_numeric(weight, errors='coerce').fillna(1)
    attack_mask = df['classification'] == 'attack'
    stats = {
        'total_events': int(weight.sum()),
        'total_rows': int(len(df)),
        'rows_pruned_by_score': int((df['signature_id'] == '').sum()),
        'signatures_analyzed_by_llm': int(len(verdicts)),
        'needs_manual_review': int(weight[df['needs_manual_review'].astype(bool)].sum()),
        'by_classification': weight.groupby(df['classification']).sum().astype(int).to_dict(),
        'by_risk_level': weight.groupby(df['risk_level']).sum().astype(int).to_dict(),
        'by_attack_type': weight[attack_mask].groupby(df['attack_type']).sum().astype(int).to_dict(),
    }
    if IP_COLUMN in df.columns:
        top_offenders = weight[attack_mask].groupby(df[IP_COLUMN].astype(str)).sum().nlargest(10)
        stats['top_offenders'] = top_offenders.astype(int).to_dict()
    return stats


def dataset_analysis(llm, df, verdicts, model='default', count_column=COUNT_COLUMN):
    """Reduce step: weighted statistics + LLM summary of the verdicts. Always returns a dict."""
    stats = build_dataset_stats(df, verdicts, count_column)
    interesting = [
        verdict for verdict in verdicts.values()
        if verdict['classification'] in ('attack', 'false_positive')
    ]
    prompt = (
        f'STATS\n{json.dumps(stats, default=str)}\n\n'
        f'VERDICTS\n{json.dumps(interesting[:REDUCE_VERDICTS], default=str)}'
    )
    _, options = get_model_options(llm, model)
    summary = ask_json_with_retries(llm, REDUCE_PROMPT, prompt, model, options)
    if summary is None:
        summary = {'summary': 'Reduce step failed'}
    elif not isinstance(summary, dict):
        summary = {'summary': summary}
    summary.update(stats)
    return summary


# ---------------------------------------------------------------------------
# Checkpoint / output
# ---------------------------------------------------------------------------
def load_checkpoint(checkpoint_path):
    try:
        with open(checkpoint_path, encoding='utf-8') as checkpoint_file:
            return json.load(checkpoint_file)
    except (IOError, ValueError):
        return {}


def save_checkpoint(checkpoint_path, verdicts):
    try:
        with open(checkpoint_path, 'w', encoding='utf-8') as checkpoint_file:
            json.dump(verdicts, checkpoint_file, default=str)
    except IOError as error:
        logger.error(f'WAF LLM checkpoint error: {error}')


def save_waf_llm_report(df, summary, output_dir=OUTPUT_DIR):
    """Two sheets: enriched events + dataset analysis. Returns the file path."""
    os.makedirs(output_dir, exist_ok=True)
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    output_file = f'{output_dir}/waf_llm_processed_{timestamp}.xlsx'
    summary_row = {
        key: json.dumps(value, default=str) if isinstance(value, (dict, list)) else value
        for key, value in summary.items()
    }
    with pd.ExcelWriter(output_file) as writer:
        df.to_excel(writer, sheet_name='events', index=False)
        pd.DataFrame([summary_row]).to_excel(writer, sheet_name='dataset_analysis', index=False)
    return output_file


# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------
def waf_llm_report(input_file, llm, model='default', signature_columns=None, context_columns=None,
                   count_column=COUNT_COLUMN, cleanup_threshold=DEFAULT_CLEANUP_THRESHOLD,
                   batch_size=None, output_dir=OUTPUT_DIR):
    """
    Rows with AbuseIPDB score >= cleanup_threshold skip the LLM. The rest is
    deduplicated into signatures and analyzed by the LLM.
    Returns (output_file_path, summary_dict) or (None, None) if the export
    has none of the signature columns.
    """
    df = load_waf_export(input_file)
    os.makedirs(output_dir, exist_ok=True)
    checkpoint_path = f'{output_dir}/waf_llm_checkpoint.json'

    if SCORE_COLUMN in df.columns:
        pruned_mask = pd.to_numeric(df[SCORE_COLUMN], errors='coerce').fillna(0) >= cleanup_threshold
    else:
        pruned_mask = pd.Series(False, index=df.index)
    logger.info(f'WAF LLM pruning: {int(pruned_mask.sum())}/{len(df)} rows with {SCORE_COLUMN} >= {cleanup_threshold}')

    df_clean, signatures = build_signatures(
        df[~pruned_mask],
        signature_columns or DEFAULT_SIGNATURE_COLUMNS,
        context_columns or DEFAULT_CONTEXT_COLUMNS,
        count_column,
    )
    if signatures is None:
        return None, None
    logger.info(f'WAF LLM: {len(df_clean)} clean rows -> {len(signatures)} unique signatures')

    verdicts = analyze_signatures(llm, signatures, checkpoint_path, model, batch_size)
    verdicts_df = pd.DataFrame(list(verdicts.values()), columns=['signature_id'] + list(ANALYSIS_DEFAULTS))
    merged_clean = df_clean.merge(verdicts_df, on='signature_id', how='left').set_index(df_clean.index)

    merged_df = pd.concat([merged_clean, annotate_pruned(df[pruned_mask], cleanup_threshold)]).sort_index()
    summary = dataset_analysis(llm, merged_df, verdicts, model, count_column)
    output_file = save_waf_llm_report(merged_df, summary, output_dir)

    if os.path.exists(checkpoint_path):
        os.remove(checkpoint_path)
    return output_file, summary
