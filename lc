{% if error %}
    <div class="row mb-2">
        <div class="col-12 text-center text-secondary">
            <small class="fst-italic mb-2"><i class="fas fa-exclamation-circle fa-lg pe-1"></i> {{ error }}</small>
        </div>
    </div>
{% elif hierarchy.ips or hierarchy.subgroups %}
    <div id="group_lookup_container" class="user-activity__item__content" style="font-family: monospace; line-height: 1.6;">
        {% include 'search_components/group_lookup_node.html' with node=hierarchy is_root=True %}
    </div>
{% else %}
    <div class="row mb-2">
        <div class="col-12 text-center text-secondary">
            <small class="fst-italic mb-2"><i class="fas fa-exclamation-circle fa-lg pe-1"></i> No data found for this group</small>
        </div>
    </div>
{% endif %}
