# views.py - get_ajax_avi_waf_filters (EMEAPLAYFLOWS-3648)
# Mismo estilo que el original: una linea explicita por cada filtro.

@user_passes_test(user_can_view_waf)
def get_ajax_avi_waf_filters(request: Any):
    context = {}

    q = Q()

    # Main query for filters
    qs_base = AviIwaf.objects.filter(q)

    # --- 1. Filter by URL details ---
    # URL (JSONField: lista de dicts {'url': ..., 'kona_protection': ...})
    urls_list = qs_base.values_list('url', flat=True)
    context['url_list'] = sorted(set([u['url'] for url_group in urls_list if url_group for u in url_group if u.get('url')]))

    context['tenant_list'] = qs_base.order_by('tenant').distinct('tenant').values_list('tenant', flat=True)
    context['vs_name_list'] = qs_base.order_by('vs_name').distinct('vs_name').values_list('vs_name', flat=True)
    context['vs_ip_list'] = qs_base.order_by('vs_ip').distinct('vs_ip').values_list('vs_ip', flat=True)

    # Servicios (JSONField: lista de strings)
    services_list = qs_base.values_list('services', flat=True)
    context['services_list'] = sorted(set([srv for services in services_list if services for srv in services]))

    context['env_list'] = qs_base.order_by('env').distinct('env').values_list('env', flat=True)

    # Pool Servers (FK PoolServer: solo ip_address; el status es campo local de AviIwaf)
    context['pool_server_list'] = qs_base.exclude(pool_server__isnull=True).order_by('pool_server__ip_address').distinct('pool_server__ip_address').values_list('pool_server__ip_address', flat=True)
    context['pool_server_status_list'] = qs_base.order_by('pool_servers_status').distinct('pool_servers_status').values_list('pool_servers_status', flat=True)
    # 'Partition' no existe en el modelo AviIwaf -> confirmar con el reporter.

    # --- 2. Filter by WAF details ---
    context['waf_policy_list'] = qs_base.order_by('waf_policy').distinct('waf_policy').values_list('waf_policy', flat=True)
    context['waf_policy_mode_list'] = qs_base.order_by('waf_policy_mode').distinct('waf_policy_mode').values_list('waf_policy_mode', flat=True)
    context['application_profile_list'] = qs_base.order_by('application_profile').distinct('application_profile').values_list('application_profile', flat=True)
    context['error_page_profile_list'] = qs_base.order_by('error_page_profile').distinct('error_page_profile').values_list('error_page_profile', flat=True)
    context['waf_profile_list'] = qs_base.order_by('waf_profile').distinct('waf_profile').values_list('waf_profile', flat=True)
    context['waf_paranoia_level_list'] = qs_base.order_by('waf_paranoia_level').distinct('waf_paranoia_level').values_list('waf_paranoia_level', flat=True)
    context['waf_crs_list'] = qs_base.order_by('waf_crs').distinct('waf_crs').values_list('waf_crs', flat=True)
    # 'Parent Name' no existe en AviIwaf (en F5Asm es parent_policy) -> confirmar.

    # --- 3. Filter by Kona Protection ---
    # kona_protection va dentro del JSONField url
    context['kona_protection_list'] = sorted(set([u['kona_protection'] for url_group in urls_list if url_group for u in url_group if u.get('kona_protection')]))
    context['kona_ddos_list'] = qs_base.order_by('kona_ddos').distinct('kona_ddos').values_list('kona_ddos', flat=True)
    context['kona_waf_list'] = qs_base.order_by('kona_waf').distinct('kona_waf').values_list('kona_waf', flat=True)
    context['kona_siteshield_group_name_list'] = qs_base.order_by('kona_siteshield_group_name').distinct('kona_siteshield_group_name').values_list('kona_siteshield_group_name', flat=True)

    # --- 4. Filter by Application (via relacion con DPR) ---
    context['application_auid_list'] = qs_base.order_by('dpr__application_auid').distinct('dpr__application_auid').values_list('dpr__application_auid', flat=True)
    context['application_name_list'] = qs_base.order_by('dpr__application_name').distinct('dpr__application_name').values_list('dpr__application_name', flat=True)
    context['app_sec_profile_list'] = qs_base.order_by('dpr__app_sec_profile').distinct('dpr__app_sec_profile').values_list('dpr__app_sec_profile', flat=True)
    context['confidentiality_list'] = qs_base.order_by('dpr__confidentiality').distinct('dpr__confidentiality').values_list('dpr__confidentiality', flat=True)
    context['vital_application_list'] = qs_base.order_by('dpr__vital_application').distinct('dpr__vital_application').values_list('dpr__vital_application', flat=True)
    context['it_continuity_criticality_list'] = qs_base.order_by('dpr__it_continuity_criticality').distinct('dpr__it_continuity_criticality').values_list('dpr__it_continuity_criticality', flat=True)

    # --- 5. Filter by Business (via relacion con DPR) ---
    # Business Line (M2M en DPR, related_name='fk_dpr_business_line'):
    # solo las BusinessLines vinculadas a DPRs que tienen algun WAF asociado
    related_dpr_ids = qs_base.exclude(dpr__isnull=True).values_list('dpr_id', flat=True)
    context['business_line_list'] = BusinessLine.objects.filter(fk_dpr_business_line__id__in=related_dpr_ids).order_by('name').distinct().values_list('name', flat=True)

    context['it_cluster_list'] = qs_base.order_by('dpr__it_cluster').distinct('dpr__it_cluster').values_list('dpr__it_cluster', flat=True)
    context['sub_it_cluster_list'] = qs_base.order_by('dpr__sub_it_cluster').distinct('dpr__sub_it_cluster').values_list('dpr__sub_it_cluster', flat=True)
    context['application_manager_list'] = qs_base.order_by('dpr__application_manager').distinct('dpr__application_manager').values_list('dpr__application_manager', flat=True)
    context['production_manager_list'] = qs_base.order_by('dpr__production_manager').distinct('dpr__production_manager').values_list('dpr__production_manager', flat=True)
    context['production_domain_manager_list'] = qs_base.order_by('dpr__production_domain_manager').distinct('dpr__production_domain_manager').values_list('dpr__production_domain_manager', flat=True)
    context['domain_manager_list'] = qs_base.order_by('dpr__domain_manager').distinct('dpr__domain_manager').values_list('dpr__domain_manager', flat=True)

    # --- 6. Filter by Metadata ---
    context['updated_signature_review_list'] = qs_base.order_by('updated_signature_review').distinct('updated_signature_review').values_list('updated_signature_review', flat=True)
    context['itsm_request_list'] = qs_base.order_by('itsm_request').distinct('itsm_request').values_list('itsm_request', flat=True)
    context['contact_list'] = qs_base.order_by('contact').distinct('contact').values_list('contact', flat=True)
    context['assigner_list'] = qs_base.order_by('assigner').distinct('assigner').values_list('assigner', flat=True)

    # Limpieza final: eliminar valores None de todas las listas
    # para que el HTML no muestre opciones vacias
    for key, value in context.items():
        if isinstance(value, list):
            context[key] = sorted(list(set([v for v in value if v is not None])))
        elif isinstance(value, set):
            context[key] = sorted(list(value))
        else:
            context[key] = sorted(list(set([v for v in value if v is not None])))

    return render(request, template_name='tools/waf_components/aviwaf_filters.html', context=context)
