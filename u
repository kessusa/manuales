{% if error %}
    <div class="alert alert-warning mb-0">{{ error }}</div>
{% else %}
    <div class="card w-100 border-0 shadow-sm group-lookup-card">
        <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between py-3">
            <div class="mr-3 me-3 mb-2">
                <div class="text-muted small">Showing results for</div>
                <h5 class="mb-0 text-primary font-weight-bold fw-bold">{{ hierarchy.group_name }}</h5>
            </div>
            <div class="d-flex flex-wrap align-items-center mb-2">
                <span class="badge badge-light bg-light text-dark border mr-2 me-2 p-2"><span id="group-lookup-group-count">-</span> groups</span>
                <span class="badge badge-light bg-light text-dark border mr-2 me-2 p-2"><span id="group-lookup-level-count">-</span> levels</span>
                <span class="badge badge-primary bg-primary text-white mr-3 me-3 p-2"><span id="group-lookup-ip-count">-</span> unique IPs</span>
                <input type="search" id="group-lookup-filter" class="form-control form-control-sm group-lookup-filter"
                       placeholder="Filter by group or IP..." autocomplete="off">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" id="group-lookup-table">
                <thead class="thead-light table-light">
                <tr>
                    <th class="text-nowrap">Group</th>
                    <th class="text-nowrap">Parent group</th>
                    <th class="text-center">Level</th>
                    <th>Direct IPs</th>
                    <th class="text-center text-nowrap">Direct</th>
                    <th class="text-center text-nowrap">Total</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% include 'search_components/group_lookup_node.html' with node=hierarchy depth=0 parent_name='' %}
                <tr id="group-lookup-no-match" class="d-none">
                    <td colspan="7" class="text-center text-muted py-3">No group or IP matches the filter</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
