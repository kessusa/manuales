error: function (xhr) {
                        $('#id_group_lookup_loader').hide();

                        let payload = xhr.responseJSON;
                        if (!payload && xhr.responseText) {
                            try {
                                payload = JSON.parse(xhr.responseText);
                            } catch (e) {
                                payload = null;
                            }
                        }

                        let message = (payload && payload.error)
                            ? payload.error
                            : 'An error occurred.';

                        // 404 is an informative "not found", not a failure
                        const css_class = (xhr.status === 404)
                            ? 'text-secondary'
                            : 'text-danger';

                        $('#id_group_lookup_content').html(
                            `<div class="text-center ${css_class}">${message}</div>`
                        );
                    }
