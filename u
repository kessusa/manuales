<div class="d-flex mb-3 fw-bold">
    <span class="me-auto"><i class="fas fa-arrow-right me-1"></i> Show result(s)</span>
    <button type="button" class="btn-close pf-close" aria-label="Close"></button>
</div>
<div class="table-responsive">
    {% if result %}
        <table class="table mb-0 table-striped table-bordered">
            <thead>
                <tr class="text-nowrap">
                    <th scope="col" class="border-0">FW Tag</th>
                    <th scope="col" class="border-0">Subgroup</th>
                    <th scope="col" class="border-0">Added value</th>
                    <th scope="col" class="border-0">Missing value</th>
                </tr>
            </thead>
            <tbody>
                {% for row in result %}
                    <tr class="text-nowrap">
                        <td class="fw-normal">
                            {{ row.fw_tag }}
                            {% if row.is_reference %}<span class="badge bg-secondary ms-1">Reference</span>{% endif %}
                        </td>
                        <td class="fw-normal">
                            {% if row.added_values or row.missing_values %}{{ row.subgroup|default:"N/A" }}{% endif %}
                        </td>
                        <td class="fw-normal text-success">
                            {% for value in row.added_values %}{{ value }}{% if not forloop.last %}<br>{% endif %}{% endfor %}
                        </td>
                        <td class="fw-normal text-danger">
                            {% for value in row.missing_values %}{{ value }}{% if not forloop.last %}<br>{% endif %}{% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="row text-center">
            <span class="text-secondary fst-italic">
                {% if group_name and reference_tag %}
                    Group {{ group_name }} was not found on {{ reference_tag }}.
                {% else %}
                    No data is currently available.
                {% endif %}
            </span>
        </div>
    {% endif %}
</div>
