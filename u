# New methods for the existing CheckPoint class (paste them inside the class).
# They follow the same pattern as get_vpn : set the domain in the auth
# credentials, login to get a domain-scoped sid, run the commands with the
# sid in the X-chkp-sid header, and logout before returning.


    # # Wait for task : verify-policy and install-policy are asynchronous,
    # # they return a task-id. This polls show-task every 2 seconds until
    # # the task is no longer in progress or the timeout is exceeded
    def wait_for_task(self, url, sid, task_id, timeout=300):
        task = {}
        elapsed = 0

        connection_args = {
            'headers': {'Content-Type': 'application/json', 'X-chkp-sid': sid},
            'json': {'task-id': task_id, 'details-level': 'full'},
            'verify': False
        }

        while elapsed < timeout:
            response = requests.post(f'{url}/show-task', **connection_args)

            if response.status_code == 200:
                # show-task returns a list of tasks, we always ask for one
                task = response.json().get('tasks', [{}])[0]

                if task.get('status') != 'in progress':
                    break

            time.sleep(2)
            elapsed += 2

        return task

    # # Get rules : returns the access rules of a policy package of a domain.
    # # Check Point organizes the rules in access layers, so we first read
    # # the package to get its layers and then dump each rulebase
    def get_rules(self, url, name, package):
        result = []

        # # Connect to MDS on the given domain
        self.auth_credentials['domain'] = name
        sid = self.login(url)

        connection_args = {
            'headers': {'Content-Type': 'application/json', 'X-chkp-sid': sid},
            'json': {'name': package},
            'verify': False
        }

        # read the package to get its access layers
        package_response = requests.post(f'{url}/show-package', **connection_args)

        if package_response.status_code == 200:

            for layer in package_response.json().get('access-layers', []):
                layer_name = layer.get('name', None)

                if layer_name:
                    # dump the rulebase of the layer. 'use-object-dictionary'
                    # returns a dictionary mapping uids to objects, used to
                    # resolve the names of sources / destinations / services
                    connection_args['json'] = {
                        'name': layer_name,
                        'details-level': 'standard',
                        'use-object-dictionary': True,
                        'limit': 500
                    }

                    rulebase_response = requests.post(
                        f'{url}/show-access-rulebase', **connection_args
                    )

                    if rulebase_response.status_code == 200:
                        rulebase_json = rulebase_response.json()

                        # build the uid -> name mapping
                        objects = {}

                        for obj in rulebase_json.get('objects-dictionary', []):
                            objects[obj.get('uid')] = obj.get('name', None)

                        # the rulebase can contain sections holding nested
                        # rules, flatten everything into a single list
                        rules = self.flatten_rulebase(rulebase_json.get('rulebase', []))

                        for item in rules:
                            result.append(
                                {
                                    'rule_id': item.get('rule-number', None),
                                    'rule_name': item.get('name', None),
                                    'layer': layer_name,
                                    'source': [objects.get(uid, uid) for uid in item.get('source', [])],
                                    'destination': [objects.get(uid, uid) for uid in item.get('destination', [])],
                                    'service': [objects.get(uid, uid) for uid in item.get('service', [])],
                                    'action': objects.get(item.get('action'), item.get('action', None)),
                                    'enabled': item.get('enabled', None),
                                    'comments': item.get('comments', None)
                                }
                            )

        # Logout
        self.logout(url, sid)

        return result

    # # Flatten rulebase : recursive helper for get_rules. Sections are
    # # identified by type 'access-section' and hold their rules in a
    # # nested 'rulebase' attribute
    def flatten_rulebase(self, rulebase):
        rules = []

        for item in rulebase or []:

            if item.get('type') == 'access-rule':
                rules.append(item)

            # go down into sections
            if item.get('rulebase', None):
                rules.extend(self.flatten_rulebase(item.get('rulebase', [])))

        return rules

    # # Find package : searches a policy package by name across all the
    # # domains of the MDS and returns its domain and installation targets.
    # # Packages without installation targets are skipped (the package may
    # # exist in several domains), same behavior as the FortiManager connector
    def find_policy_package(self, url, package_name):
        result = None

        for domain in self.get_domain(url) or []:

            # # Connect to MDS on the domain
            self.auth_credentials['domain'] = domain
            sid = self.login(url)

            connection_args = {
                'headers': {'Content-Type': 'application/json', 'X-chkp-sid': sid},
                'json': {'name': package_name, 'details-level': 'full'},
                'verify': False
            }

            package_response = requests.post(f'{url}/show-package', **connection_args)

            # Logout
            self.logout(url, sid)

            if package_response.status_code == 200:
                package_json = package_response.json()

                # 'installation-targets' is either the string 'all'
                # (every gateway of the domain) or a list of gateways
                targets = package_json.get('installation-targets', None)

                installation_targets = []

                if targets == 'all':
                    installation_targets.append({'device': 'all'})

                elif targets:
                    for target in targets:
                        installation_targets.append(
                            {'device': target.get('name', None)}
                        )

                # skip packages without installation targets and keep
                # searching in the remaining domains
                if installation_targets:
                    result = {
                        'domain': domain,
                        'package': package_json.get('name', None),
                        'installation_targets': installation_targets
                    }
                    break

        return result

    # # Verify : closest equivalent to the FortiManager preview. It runs the
    # # policy verification of the package (consistency checks, conflicts)
    # # without installing anything, and returns the verification result
    def verify_policy_package(self, url, name, package, timeout=300):
        # # Connect to MDS on the given domain
        self.auth_credentials['domain'] = name
        sid = self.login(url)

        connection_args = {
            'headers': {'Content-Type': 'application/json', 'X-chkp-sid': sid},
            'json': {'policy-package': package},
            'verify': False
        }

        response = requests.post(f'{url}/verify-policy', **connection_args)

        task = {}

        if response.status_code == 200:
            task_id = response.json().get('task-id', None)

            if task_id:
                task = self.wait_for_task(url, sid, task_id, timeout)

        # Logout
        self.logout(url, sid)

        return {
            'status': task.get('status', None),
            'progress': task.get('progress-percentage', None),
            # the verification messages are inside task-details
            'details': task.get('task-details', [])
        }

    # # Install : installs a policy package on its targets.
    # # WARNING : this pushes the policy to the real gateways of the domain.
    # # Returns the final task status so the caller can verify the result
    def install_policy_package(self, url, name, package, targets=None, timeout=600):
        # # Connect to MDS on the given domain
        self.auth_credentials['domain'] = name
        sid = self.login(url)

        payload = {
            'policy-package': package,
            # install the access control part of the package
            'access': True
        }

        # if no targets are given, Check Point installs the package on its
        # own installation targets
        if targets:
            payload['targets'] = targets

        connection_args = {
            'headers': {'Content-Type': 'application/json', 'X-chkp-sid': sid},
            'json': payload,
            'verify': False
        }

        response = requests.post(f'{url}/install-policy', **connection_args)

        task = {}
        task_id = None

        if response.status_code == 200:
            task_id = response.json().get('task-id', None)

            if task_id:
                task = self.wait_for_task(url, sid, task_id, timeout)

        # Logout
        self.logout(url, sid)

        return {
            'task_id': task_id,
            'status': task.get('status', None),
            'progress': task.get('progress-percentage', None),
            'details': task.get('task-details', [])
        }
