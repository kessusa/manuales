# views.py — get_ajax_avi_waf_filters (EMEAPLAYFLOWS-3648)
# Filtros del AVI WAF organizados por las 6 categorías del ticket.
# Requiere PostgreSQL (usa .distinct(campo) / DISTINCT ON).

@user_passes_test(user_can_view_waf)
def get_ajax_avi_waf_filters(request: Any):
    context = {}
    qs_base = AviIwaf.objects.filter(Q())

    def distinct_list(field, qs=None):
        """Valores unicos de un campo, ordenados y sin nulos."""
        qs = qs if qs is not None else qs_base
        return list(
            qs.exclude(**{field + "__isnull": True})
              .order_by(field)
              .distinct(field)
              .values_list(field, flat=True)
        )

    def json_flat_list(field):
        """Aplana un JSONField que contiene listas y devuelve valores unicos ordenados."""
        raw = qs_base.values_list(field, flat=True)
        return sorted({item for group in raw if group for item in group if item})

    # --- 1. Filter by URL details ---
    context["url_list"] = json_flat_list("url")
    context["tenant_list"] = distinct_list("tenant")
    context["vs_name_list"] = distinct_list("vs_name")
    context["vs_ip_list"] = distinct_list("vs_ip")
    context["services_list"] = json_flat_list("services")
    context["env_list"] = distinct_list("env")
    # Pool servers via FK PoolServer. OJO: verifica que PoolServer tenga
    # los campos ip_address y status; si no, usa el campo local
    # 'pool_servers_status' de AviIwaf (comentado abajo).
    context["pool_server_list"] = distinct_list("pool_server__ip_address")
    context["pool_server_status_list"] = distinct_list("pool_server__status")
    # context["pool_server_status_list"] = distinct_list("pool_servers_status")
    # 'Partition' no existe en el modelo AviIwaf -> confirmar con el reporter
    # si hay que anadir el campo o si solo aplica a F5.

    # --- 2. Filter by WAF details ---
    waf_fields = {
        "waf_policy_list": "waf_policy",
        "waf_policy_mode_list": "waf_policy_mode",
        "application_profile_list": "application_profile",
        "waf_profile_list": "waf_profile",
        "waf_paranoia_level_list": "waf_paranoia_level",
        "waf_crs_list": "waf_crs",
    }
    for key, field in waf_fields.items():
        context[key] = distinct_list(field)
    # 'Parent Name' no existe en AviIwaf (en F5Asm es parent_policy) -> confirmar.

    # --- 3. Filter by Kona Protection ---
    kona_fields = {
        "kona_ddos_list": "kona_ddos",
        "kona_waf_list": "kona_waf",
        "kona_siteshield_group_name_list": "kona_siteshield_group_name",
    }
    for key, field in kona_fields.items():
        context[key] = distinct_list(field)

    # --- 4. Filter by Application (via relacion con DPR) ---
    # --- 5. Filter by Business (via relacion con DPR) ---
    dpr_fields = {
        # Application
        "application_auid_list": "dpr__application_auid",
        "application_name_list": "dpr__application_name",
        "app_sec_profile_list": "dpr__app_sec_profile",
        "confidentiality_list": "dpr__confidentiality",
        "vital_application_list": "dpr__vital_application",
        "it_continuity_criticality_list": "dpr__it_continuity_criticality",
        # Business
        "it_cluster_list": "dpr__it_cluster",
        "sub_it_cluster_list": "dpr__sub_it_cluster",
        "application_manager_list": "dpr__application_manager",
        "production_manager_list": "dpr__production_manager",
        "production_domain_manager_list": "dpr__production_domain_manager",
        "domain_manager_list": "dpr__domain_manager",
    }
    for key, field in dpr_fields.items():
        context[key] = distinct_list(field)

    # Business Line (ManyToMany en DPR, related_name='fk_dpr_business_line').
    # Solo BusinessLines vinculadas a DPRs que tienen algun WAF asociado.
    related_dpr_ids = qs_base.exclude(dpr__isnull=True).values_list("dpr_id", flat=True)
    context["business_line_list"] = list(
        BusinessLine.objects
        .filter(fk_dpr_business_line__id__in=related_dpr_ids)
        .order_by("name")
        .distinct()
        .values_list("name", flat=True)
    )

    # --- 6. Filter by Metadata ---
    metadata_fields = {
        "updated_signature_review_list": "updated_signature_review",
        "itsm_request_list": "itsm_request",
        "contact_list": "contact",
        "assigner_list": "assigner",
    }
    for key, field in metadata_fields.items():
        context[key] = distinct_list(field)

    # Ya no hace falta la limpieza final: distinct_list excluye nulos en origen
    # y json_flat_list ya devuelve sets ordenados.

    return render(request, template_name="tools/waf_components/aviwaf_filters.html", context=context)
