import ipaddress
import socket
from concurrent.futures import ThreadPoolExecutor


# --- 2) Module level, next to get_ip_list() / ENV_LABELS -----------------
IPLIST_MAX_EXPANDED_IPS = 256
DNS_LOOKUP_WORKERS = 16


def expand_ip_range(ip_begin, ip_end=None, limit=IPLIST_MAX_EXPANDED_IPS):
    """Return the IPs between ip_begin and ip_end. Ranges bigger than limit are kept as 'begin-end'."""
    if not ip_end or ip_end == ip_begin:
        return [ip_begin]

    try:
        start = int(ipaddress.ip_address(ip_begin))
        end = int(ipaddress.ip_address(ip_end))
    except ValueError:
        return [f'{ip_begin}-{ip_end}']

    if end < start or end - start + 1 > limit:
        return [f'{ip_begin}-{ip_end}']

    return [str(ipaddress.ip_address(ip)) for ip in range(start, end + 1)]


def resolve_dns_name(ip_address):
    try:
        return socket.gethostbyaddr(ip_address)[0]
    except (OSError, ValueError):
        return None


def resolve_dns_names(ip_addresses):
    """Reverse DNS lookups in parallel; returns {ip_address: dns_name}."""
    if not ip_addresses:
        return {}

    with ThreadPoolExecutor(max_workers=DNS_LOOKUP_WORKERS) as executor:
        return dict(zip(ip_addresses, executor.map(resolve_dns_name, ip_addresses)))


