import logging

import requests

from bookmark.settings import INETPORTAL_BASE_URL, INETPORTAL_USERNAME, INETPORTAL_PASSWORD

logger = logging.getLogger(__name__)


class InetPortalV2:
    def __init__(self):

        self.base_url = INETPORTAL_BASE_URL
        self.username = INETPORTAL_USERNAME
        self.password = INETPORTAL_PASSWORD
        self.token = None

        # Headers
        self.headers = {
            'accept': 'application/json',
            'Content-Type': 'application/json'
        }

        self.connection_args = {
            'proxies': {'https': None},
            'headers': self.headers,
            'verify': False
        }

    # # Login / Token
    def get_token(self):

        self.connection_args['headers'] = {
            'accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded'
        }

        auth_data = {
            'grant_type': 'password',
            'username': self.username,
            'password': self.password,
            'scope': '',
            'client_id': 'string',
            'client_secret': ''
        }

        response = requests.post(f'{self.base_url}/token', data=auth_data, **self.connection_args)
        if response.status_code == 200:
            self.token = response.json().get('access_token')
            return self.token

        logger.error(f'INET Portal: /token returned {response.status_code}')
        self.token = None
        return None

    def get_loadbalancer(self, params):
        """GET /loadbalancer reusing the session token; on 401 the token is renewed and the call retried once."""
        response = None
        try:
            for attempt in range(2):
                if attempt or not self.token:
                    if not self.get_token():
                        return None

                self.connection_args['headers'] = {
                    **self.headers,
                    'Authorization': f'Bearer {self.token}'
                }

                response = requests.get(f'{self.base_url}/loadbalancer', params=params, **self.connection_args)
                if response.status_code == 200:
                    return response.json().get('data', [])
                if response.status_code != 401:
                    break
        except requests.RequestException as exc:
            logger.error(f'INET Portal: /loadbalancer request failed for {params.get("search_string")}: {exc}')
            return None

        logger.error(
            f'INET Portal: /loadbalancer returned {response.status_code} for {params.get("search_string")}'
        )
        return None

    def get_vs_auid_and_status(self, vs_name):
        params = {
            'page': 0,
            'limit': 1,
            'search_string': vs_name,
            'techno': 'all'
        }

        response = self.get_loadbalancer(params)
        if response:
            data = response[0]
            auid = None
            for admin in data.get('administrative', []):
                auid = admin.get('auid') or admin.get('APPLICATION_NAME_VALUE')
                if auid:
                    break

            return {
                'application_auid': auid,
                'pool_servers_status': data['pool'][0].get('state') if data.get('pool') else None,
                'vs_status': data.get('enabled'),
            }

        return None

    def get_data_to_enrich_f5_details(self, vs_name):
        params = {
            'search_string': vs_name,
            'page': 0,
            'limit': 30,
            'techno': 'All',
        }

        response = self.get_loadbalancer(params)
        if response:
            data = response[0]
            auid = None
            for admin in data.get('administrative', []):
                auid = admin.get('auid') or admin.get('APPLICATION_NAME_VALUE')
                if auid:
                    break
            frontend = data.get('frontend', {})
            pools = data.get('pool', [])

            pool_servers = [
                member.get('ip') for pool in pools for member in (pool.get('members') or []) if member.get('ip')
            ]

            return {
                'vs_name': data.get('name'),
                'vs_ip': frontend.get('ip'),
                'vs_services': frontend.get('port', []),
                'vs_status': data.get('enabled'),
                'pool_servers_status': pools[0].get('state') if pools else None,
                'pool_servers': pool_servers,
                'application_auid': auid,
            }

        return None
