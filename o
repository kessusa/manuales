class FortiManagerAPI:
    def __init__(self):
        self.url = f"https://{FMG_HOST}/jsonrpc"
        self.session = requests.Session()
        self.session.verify = False
        self.token = None
        self.req_id = 1

    def _call(self, method, params):
        payload = {"id": self.req_id, "method": method, "params": params}
        if self.token and not FMG_TOKEN:
            payload["session"] = self.token
        headers = {"Content-Type": "application/json"}
        if FMG_TOKEN:
            headers["Authorization"] = f"Bearer {FMG_TOKEN}"

        self.req_id += 1
        resp = self.session.post(self.url, json=payload, headers=headers, timeout=60)
        resp.raise_for_status()
        data = resp.json()
        res = data.get("result", [{}])[0]
        if res.get("status", {}).get("code", -1) != 0:
            raise RuntimeError(f"Error FMG API: {res.get('status')}")
        return res.get("data")

    def login(self):
        if FMG_TOKEN:
            return
        payload = {
            "id": 1,
            "method": "exec",
            "params": [{"url": "/sys/login/user", "data": {"user": FMG_USER, "passwd": FMG_PASS}}]
        }
        r = self.session.post(self.url, json=payload, verify=False).json()
        self.token = r.get("session")

    def logout(self):
        if self.token and not FMG_TOKEN:
            self._call("exec", [{"url": "/sys/logout"}])

    def lock_adom(self, adom):
        try:
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/lock"}])
        except RuntimeError:
            pass

    def commit_and_unlock(self, adom):
        try:
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/commit"}])
            self._call("exec", [{"url": f"/pm/config/adom/{adom}/_workspace/unlock"}])
        except RuntimeError:
            pass

    def get_policies(self, adom, pkg):
        return self._call("get", [{"url": f"/pm/config/adom/{adom}/pkg/{pkg}/firewall/policy"}]) or []


def fmg_backup_package(adom, pkg, policies):
    os.makedirs("backups_fmg", exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    fname = f"backups_fmg/{adom}_{pkg}_{ts}.json"
    with open(fname, "w", encoding="utf-8") as f:
        json.dump(policies, f, indent=2)
    return fname


def fmg_build_address_resolver(fmg, adom):
    """Resuelve recursivamente objetos firewall address y addrgrp a redes ipaddress"""
    addrs = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/address"}]) or []
    grps = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/addrgrp"}]) or []

    direct_map = {"all": [ipaddress.ip_network("0.0.0.0/0")], "none": []}
    for a in addrs:
        name = a.get("name")
        atype = a.get("type", "ipmask")
        if atype in (0, "ipmask") and a.get("subnet"):
            sub = a["subnet"]
            try:
                if isinstance(sub, list) and len(sub) == 2:
                    direct_map[name] = [ipaddress.ip_network(f"{sub[0]}/{subnet[1] if 'subnet' in locals() else sub[1]}", strict=False)]
                elif isinstance(sub, str):
                    direct_map[name] = [ipaddress.ip_network(sub.replace(" ", "/"), strict=False)]
            except ValueError:
                pass
        elif atype in (1, "iprange") and a.get("start-ip") and a.get("end-ip"):
            try:
                start = ipaddress.ip_address(a["start-ip"])
                end = ipaddress.ip_address(a["end-ip"])
                direct_map[name] = list(ipaddress.summarize_address_range(start, end))
            except ValueError:
                pass

    grp_map = {g["name"]: as_list(g.get("member")) for g in grps if "name" in g}

    def resolve_names(names, visited=None):
        visited = visited or set()
        nets = []
        for n in names:
            if n in visited:
                continue
            visited.add(n)
            if n in direct_map:
                nets.extend(direct_map[n])
            elif n in grp_map:
                nets.extend(resolve_names(grp_map[n], visited))
        return nets

    return {k: resolve_names([k]) for k in list(direct_map.keys()) + list(grp_map.keys())}


def fmg_parse_port_ranges(range_str):
    ranges = []
    if not range_str:
        return ranges
    tokens = range_str if isinstance(range_str, list) else str(range_str).split()
    for token in tokens:
        dst_part = token.split(":")[0]
        if "-" in dst_part:
            p1, p2 = dst_part.split("-", 1)
            ranges.append((int(p1), int(p2)))
        elif dst_part.isdigit():
            p = int(dst_part)
            ranges.append((p, p))
    return ranges


def fmg_build_service_resolver(fmg, adom):
    """Resuelve servicios custom y grupos de servicios en rangos de puertos TCP/UDP"""
    svcs = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/service/custom"}]) or []
    sgrps = fmg._call("get", [{"url": f"/pm/config/adom/{adom}/obj/firewall/service/group"}]) or []

    svc_map = {"ALL": {"tcp": [(1, 65535)], "udp": [(1, 65535)], "all": True}}
    for s in svcs:
        name = s.get("name")
        proto = s.get("protocol", "TCP/UDP/SCTP")
        is_all = proto in ("ALL", 6) or (not s.get("tcp-portrange") and not s.get("udp-portrange") and proto == "IP")
        svc_map[name] = {
            "tcp": fmg_parse_port_ranges(s.get("tcp-portrange")),
            "udp": fmg_parse_port_ranges(s.get("udp-portrange")),
            "all": is_all
        }

    grp_map = {g["name"]: as_list(g.get("member")) for g in sgrps if "name" in g}

    def resolve_svcs(names, visited=None):
        visited = visited or set()
        merged = {"tcp": [], "udp": [], "all": False}
        for n in names:
            if n in visited:
                continue
            visited.add(n)
            if n in svc_map:
                if svc_map[n]["all"]:
                    merged["all"] = True
                merged["tcp"].extend(svc_map[n]["tcp"])
                merged["udp"].extend(svc_map[n]["udp"])
            elif n in grp_map:
                sub = resolve_svcs(grp_map[n], visited)
                if sub["all"]:
                    merged["all"] = True
                merged["tcp"].extend(sub["tcp"])
                merged["udp"].extend(sub["udp"])
        return merged

    return {k: resolve_svcs([k]) for k in list(svc_map.keys()) + list(grp_map.keys())}


def cmd_fmg_unused(args):
    """Deshabilita o elimina políticas sin uso en FortiManager"""
    fmg = FortiManagerAPI()
    fmg.login()
    try:
        policies = fmg.get_policies(args.adom, args.pkg)
        bkp = fmg_backup_package(args.adom, args.pkg, policies)
        print(f"[*] Políticas en '{args.adom}/{args.pkg}': {len(policies)} (Backup: {bkp})")

        now_ts = int(time.time())
        cutoff_seconds = args.days * 86400
        candidates = []

        for pol in policies:
            pid = pol.get("policyid")
            status = pol.get("status", "enable")
            label = pol.get("global-label", "")
            comments = pol.get("comments", "") or ""

            if args.tag and args.tag.lower() not in str(label).lower() and args.tag.lower() not in comments.lower():
                continue
            if args.action == "disable" and status == "disable":
                continue

            hits = int(pol.get("_hitcount", pol.get("hit-count", 0)) or 0)
            last_used = int(pol.get("_last_used", pol.get("last-used", 0)) or 0)

            if hits == 0:
                candidates.append((pol, "0 Hits totales"))
            elif last_used > 0 and (now_ts - last_used) > cutoff_seconds:
                days_ago = (now_ts - last_used) // 86400
                candidates.append((pol, f"Sin tráfico hace {days_ago} días (> {args.days}d)"))

        print(f"[*] Detectadas {len(candidates)} reglas sin uso.")
        if args.dry_run or not candidates:
            for pol, reason in candidates:
                print(f"  [DRY-RUN] PolicyID {pol['policyid']} ({pol.get('name')}) -> {args.action.upper()} | {reason}")
            return

        fmg.lock_adom(args.adom)
        today = datetime.now().strftime("%Y-%m-%d")
        for pol, reason in candidates:
            pid = pol["policyid"]
            pol_url = f"/pm/config/adom/{args.adom}/pkg/{args.pkg}/firewall/policy/{pid}"
            if args.action == "disable":
                old_c = pol.get("comments", "") or ""
                new_c = f"{old_c} [AUTO-DISABLED {today}: {reason}]".strip()
                fmg._call("update", [{"url": pol_url, "data": {"status": "disable", "comments": new_c}}])
                print(f"[+] PolicyID {pid} DESHABILITADA ({reason})")
            elif args.action == "delete":
                fmg._call("delete", [{"url": pol_url}])
                print(f"[-] PolicyID {pid} ELIMINADA ({reason})")
        fmg.commit_and_unlock(args.adom)
    finally:
        fmg.logout()


def cmd_fmg_shadow(args):
    """Detecta reglas en sombra (Shadowed) y opcionalmente deshabilita las redundantes"""
    fmg = FortiManagerAPI()
    fmg.login()
    try:
        policies = fmg.get_policies(args.adom, args.pkg)
        addr_map = fmg_build_address_resolver(fmg, args.adom)
        active_upper = []
        shadowed_found = []

        def is_addr_sub(sub_names, super_names):
            if "all" in super_names or sub_names.issubset(super_names):
                return True
            sub_nets = [net for name in sub_names for net in addr_map.get(name, [])]
            sup_nets = [net for name in super_names for net in addr_map.get(name, [])]
            if not sub_nets or not sup_nets:
                return False
            return all(any(sn.subnet_of(spn) for spn in sup_nets) for sn in sub_nets)

        def is_field_sub(sub_s, sup_s, wc):
            return wc in sup_s or sub_s.issubset(sup_s)

        for pol in policies:
            if pol.get("status") == "disable":
                continue
            pid = pol["policyid"]
            p_srcintf = as_set(pol.get("srcintf"))
            p_dstintf = as_set(pol.get("dstintf"))
            p_srcaddr = as_set(pol.get("srcaddr"))
            p_dstaddr = as_set(pol.get("dstaddr"))
            p_svc     = as_set(pol.get("service"))
            p_sched   = as_set(pol.get("schedule"))

            for upper in active_upper:
                if (is_field_sub(p_srcintf, upper["srcintf"], "any") and
                    is_field_sub(p_dstintf, upper["dstintf"], "any") and
                    is_addr_sub(p_srcaddr, upper["srcaddr"]) and
                    is_addr_sub(p_dstaddr, upper["dstaddr"]) and
                    is_field_sub(p_svc, upper["service"], "ALL") and
                    is_field_sub(p_sched, upper["schedule"], "always")):

                    same_act = (pol.get("action") == upper["raw"].get("action"))
                    stype = "REDUNDANTE (Misma acción)" if same_act else "CONFLICTO (Acción opuesta oculta)"
                    shadowed_found.append({
                        "shadowed_id": pid,
                        "shadowed_name": pol.get("name"),
                        "by_id": upper["id"],
                        "by_name": upper["raw"].get("name"),
                        "type": stype,
                        "same_action": same_act
                    })
                    break

            active_upper.append({
                "id": pid, "srcintf": p_srcintf, "dstintf": p_dstintf,
                "srcaddr": p_srcaddr, "dstaddr": p_dstaddr,
                "service": p_svc, "schedule": p_sched, "raw": pol
            })

        print(f"[*] Detectadas {len(shadowed_found)} reglas en sombra:")
        for s in shadowed_found:
            print(f"  • PolicyID {s['shadowed_id']} ({s['shadowed_name']}) tapada por PolicyID {s['by_id']} ({s['by_name']}) -> [{s['type']}]")

        if args.disable_redundant and shadowed_found:
            fmg.lock_adom(args.adom)
            for s in shadowed_found:
                if s["same_action"]:
                    url = f"/pm/config/adom/{args.adom}/pkg/{args.pkg}/firewall/policy/{s['shadowed_id']}"
                    fmg._call("update", [{"url": url, "data": {"status": "disable"}}])
                    print(f"[+] PolicyID {s['shadowed_id']} deshabilitada por redundancia.")
            fmg.commit_and_unlock(args.adom)
    finally:
        fmg.logout()


def cmd_fmg_consolidate(args):
    """Agrupa políticas equivalentes sin saltar reglas de bloqueo intermedias"""
    fmg = FortiManagerAPI()
    fmg.login()
    try:
        policies = fmg.get_policies(args.adom, args.pkg)
        fmg_backup_package(args.adom, args.pkg, policies)

        def base_sig(pol):
            return (
                tuple(sorted(as_set(pol.get("srcintf")))),
                tuple(sorted(as_set(pol.get("dstintf")))),
                pol.get("action"), pol.get("nat"), pol.get("schedule"),
                pol.get("utm-status"),
                tuple(sorted(as_set(pol.get("av-profile")))),
                tuple(sorted(as_set(pol.get("ips-sensor")))),
                tuple(sorted(as_set(pol.get("webfilter-profile")))),
                tuple(sorted(as_set(pol.get("application-list")))),
                tuple(sorted(as_set(pol.get("ssl-ssh-profile"))))
            )

        merges = []
        skip_ids = set()

        for i, pol_a in enumerate(policies):
            if pol_a.get("status") == "disable" or pol_a["policyid"] in skip_ids:
                continue
            if args.tag and args.tag.lower() not in str(pol_a.get("global-label", "")).lower():
                continue

            sig_a = base_sig(pol_a)
            a_src = as_set(pol_a.get("srcaddr"))
            a_dst = as_set(pol_a.get("dstaddr"))
            a_svc = as_set(pol_a.get("service"))

            for j in range(i + 1, len(policies)):
                pol_b = policies[j]
                if pol_b.get("status") == "disable" or pol_b["policyid"] in skip_ids:
                    continue
                if pol_b.get("action") != pol_a.get("action"):
                    if as_set(pol_b.get("srcintf")) & as_set(pol_a.get("srcintf")):
                        break
                if base_sig(pol_b) != sig_a:
                    continue

                b_src = as_set(pol_b.get("srcaddr"))
                b_dst = as_set(pol_b.get("dstaddr"))
                b_svc = as_set(pol_b.get("service"))

                if sum([a_src != b_src, a_dst != b_dst, a_svc != b_svc]) <= 1:
                    a_src |= b_src
                    a_dst |= b_dst
                    a_svc |= b_svc
                    skip_ids.add(pol_b["policyid"])
                    merges.append({
                        "master_id": pol_a["policyid"],
                        "absorbed_id": pol_b["policyid"],
                        "new_srcaddr": sorted(list(a_src)),
                        "new_dstaddr": sorted(list(a_dst)),
                        "new_service": sorted(list(a_svc))
                    })

        print(f"[*] Detectadas {len(merges)} fusiones seguras:")
        for m in merges:
            print(f"  • Fusionar PolicyID {m['absorbed_id']} -> en PolicyID {m['master_id']}")
            print(f"      src: {m['new_srcaddr']} | dst: {m['new_dstaddr']} | svc: {m['new_service']}")

        if args.apply and merges:
            fmg.lock_adom(args.adom)
            for m in merges:
                m_url = f"/pm/config/adom/{args.adom}/pkg/{args.pkg}/firewall/policy/{m['master_id']}"
                a_url = f"/pm/config/adom/{args.adom}/pkg/{args.pkg}/firewall/policy/{m['absorbed_id']}"
                fmg._call("update", [{"url": m_url, "data": {"srcaddr": m["new_srcaddr"], "dstaddr": m["new_dstaddr"], "service": m["new_service"]}}])
                fmg._call("update", [{"url": a_url, "data": {"status": "disable", "comments": f"[MERGED INTO POLICY {m['master_id']}]"}}])
            fmg.commit_and_unlock(args.adom)
            print("[+] Reglas consolidadas correctamente.")
    finally:
        fmg.logout()


def cmd_fmg_finder(args):
    """Simula tráfico Top-Down y sugiere reglas candidatas para ampliar por afinidad"""
    fmg = FortiManagerAPI()
    fmg.login()
    try:
        policies = fmg.get_policies(args.adom, args.pkg)
        addr_cat = fmg_build_address_resolver(fmg, args.adom)
        svc_cat  = fmg_build_service_resolver(fmg, args.adom)

        src_nets = [ipaddress.ip_network(s, strict=False) for s in args.src]
        dst_nets = [ipaddress.ip_network(d, strict=False) for d in args.dst]
        parsed_ports = []
        for p in args.ports:
            if "/" in p:
                pr, po = p.split("/", 1)
                parsed_ports.append((pr.lower(), int(po)))
            else:
                parsed_ports.append(("tcp", int(p)))

        def ip_match(ip_net, field_names):
            if "all" in field_names:
                return True
            return any(ip_net.subnet_of(net) for name in field_names for net in addr_cat.get(name, []))

        def ip_sim_subnet(ip_net, field_names, mask=24):
            if "all" in field_names or ip_net.prefixlen < mask:
                return False
            sup = ip_net.supernet(new_prefix=mask)
            return any(net.prefixlen >= mask and net.overlaps(sup) for name in field_names for net in addr_cat.get(name, []))

        def port_match(proto, port, svc_names):
            if "ALL" in svc_names:
                return True
            for s_name in svc_names:
                sd = svc_cat.get(s_name)
                if sd and (sd["all"] or any(pmin <= port <= pmax for pmin, pmax in sd.get(proto, []))):
                    return True
            return False

        print("\n======================================================================")
        print(" FASE 1: SIMULACIÓN SECUENCIAL TOP-DOWN (ESTADO ACTUAL)")
        print("======================================================================")
        unpermitted = []

        for s_net in src_nets:
            for d_net in dst_nets:
                for proto, port in parsed_ports:
                    matched = None
                    for idx, pol in enumerate(policies):
                        if pol.get("status") == "disable":
                            continue
                        if (ip_match(s_net, as_list(pol.get("srcaddr"))) and
                            ip_match(d_net, as_list(pol.get("dstaddr"))) and
                            port_match(proto, port, as_list(pol.get("service")))):
                            matched = (idx + 1, pol)
                            break

                    flow_str = f"{s_net} -> {d_net} [{proto.upper()}/{port}]"
                    if matched:
                        pos, r = matched
                        act = r.get("action", "deny").upper()
                        pid = r.get("policyid")
                        rname = r.get("name", f"ID_{pid}")
                        if act == "ACCEPT":
                            print(f"  [PERMITIDO] {flow_str} ==> Match en Pos #{pos}: PolicyID {pid} ('{rname}')")
                        else:
                            print(f"  [BLOQUEADO] {flow_str} ==> DENY en Pos #{pos}: PolicyID {pid} ('{rname}')")
                            unpermitted.append((s_net, d_net, proto, port, pos))
                    else:
                        print(f"  [DENEGADO]  {flow_str} ==> Sin coincidencia (Implicit Deny final)")
                        unpermitted.append((s_net, d_net, proto, port, len(policies) + 1))

        if not unpermitted:
            print("\n[+] Todo el tráfico solicitado YA ESTÁ PERMITIDO.")
            return

        print("\n======================================================================")
        print(" FASE 2: RECOMENDACIÓN DE REGLAS CANDIDATAS POR AFINIDAD")
        print("======================================================================")
        candidates = []

        for idx, pol in enumerate(policies):
            if pol.get("status") == "disable" or pol.get("action") != "accept":
                continue
            if args.tag and args.tag.lower() not in str(pol.get("global-label", "")).lower():
                continue

            p_srcs = as_list(pol.get("srcaddr"))
            p_dsts = as_list(pol.get("dstaddr"))
            p_svcs = as_list(pol.get("service"))
            if "all" in p_srcs and "all" in p_dsts:
                continue

            src_ex = sum(1 for s in src_nets if ip_match(s, p_srcs))
            src_sb = sum(1 for s in src_nets if not ip_match(s, p_srcs) and ip_sim_subnet(s, p_srcs))
            dst_ex = sum(1 for d in dst_nets if ip_match(d, p_dsts))
            dst_sb = sum(1 for d in dst_nets if not ip_match(d, p_dsts) and ip_sim_subnet(d, p_dsts))
            prt_ex = sum(1 for pr, po in parsed_ports if port_match(pr, po, p_svcs))

            r_src = src_ex / len(src_nets)
            r_dst = dst_ex / len(dst_nets)
            r_prt = prt_ex / len(parsed_ports)
            r_dst_sim = (dst_ex + dst_sb) / len(dst_nets)
            r_src_sim = (src_ex + src_sb) / len(src_nets)

            reasons = []
            score = 0

            if r_prt > 0 and (r_dst > 0 or r_dst_sim > 0):
                score += (r_prt * 40) + (r_dst * 35) + ((r_dst_sim - r_dst) * 20) + (r_src * 25)
                if r_prt == 1.0 and r_dst > 0:
                    reasons.append(f"Mismos puertos ({prt_ex}/{len(parsed_ports)}) hacia {dst_ex}/{len(dst_nets)} destinos")
                elif dst_sb > 0:
                    reasons.append(f"Mismos puertos hacia la misma subred /24 de tus destinos ({dst_sb} coincidencias)")

            if r_src > 0 and r_prt > 0:
                score = max(score, (r_src * 45) + (r_prt * 40) + (r_dst * 15))
                reasons.append(f"Ya tiene {src_ex}/{len(src_nets)} orígenes y {prt_ex}/{len(parsed_ports)} puertos")

            if (r_src > 0 or r_src_sim > 0) and (r_dst > 0 or r_dst_sim > 0) and r_prt < 1.0:
                score = max(score, (r_src * 45) + (r_dst * 45) + (r_prt * 10))
                reasons.append(f"Ya comunica orígenes ({src_ex}/{len(src_nets)}) con destinos ({dst_ex}/{len(dst_nets)})")

            if score < 35:
                continue

            miss_src = [str(s) for s in src_nets if not ip_match(s, p_srcs)]
            miss_dst = [str(d) for d in dst_nets if not ip_match(d, p_dsts)]
            miss_prt = [f"{pr.upper()}/{po}" for pr, po in parsed_ports if not port_match(pr, po, p_svcs)]
            blocked_above = any((idx + 1) > deny_pos for _, _, _, _, deny_pos in unpermitted)

            candidates.append({
                "pos": idx + 1, "id": pol["policyid"], "name": pol.get("name", f"ID_{pol['policyid']}"),
                "score": round(min(score, 99.0), 1), "srcintf": as_list(pol.get("srcintf")),
                "dstintf": as_list(pol.get("dstintf")), "reasons": list(dict.fromkeys(reasons)),
                "miss_src": miss_src, "miss_dst": miss_dst, "miss_prt": miss_prt, "blocked": blocked_above
            })

        candidates.sort(key=lambda x: x["score"], reverse=True)
        if not candidates:
            print("  [-] Sin candidatas claras. Se recomienda crear regla nueva.")
            return

        for c in candidates[:8]:
            warn = " [¡ATENCIÓN: Regla DENY por encima!]" if c["blocked"] else ""
            print(f"\n  ★ CANDIDATA PolicyID {c['id']} ('{c['name']}') | Pos #{c['pos']} | Afinidad: {c['score']}%{warn}")
            print(f"    Interfaces : {c['srcintf']} -> {c['dstintf']}")
            print(f"    Motivos    : {' | '.join(c['reasons'])}")
            acc = []
            if c["miss_src"]: acc.append(f"Añadir srcaddr: {c['miss_src']}")
            if c["miss_dst"]: acc.append(f"Añadir dstaddr: {c['miss_dst']}")
            if c["miss_prt"]: acc.append(f"Añadir service: {c['miss_prt']}")
            print(f"    Cambio req.: {' ; '.join(acc)}")
    finally:
        fmg.logout()


