    p_rbk = sub.add_parser("avi-rollback", help="Restaura una política WAF desde backup JSON")
    p_rbk.add_argument("--file", required=True, help="Ruta al archivo JSON de backup")
    p_rbk.set_defaults(func=cmd_avi_rollback)

    # --- SUBCOMANDOS FORTIMANAGER ---
    p_unu = sub.add_parser("fmg-unused", help="Limpia políticas sin uso (0 hits / inactivas)")
    p_unu.add_argument("--adom", required=True)
    p_unu.add_argument("--pkg", required=True)
    p_unu.add_argument("--tag", help="Filtrar por Policy Tag / comentario")
