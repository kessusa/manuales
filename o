    p_crs.add_argument("--disable", action="store_true", help="Deshabilitar en vez de habilitar")
    p_crs.add_argument("--mode", default="WAF_MODE_ENFORCEMENT", choices=["WAF_MODE_ENFORCEMENT", "WAF_MODE_DETECTION_ONLY"])
    p_crs.add_argument("--filter", help="Filtrar por nombre de política")
    p_crs.add_argument("--dry-run", action="store_true")
