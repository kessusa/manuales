"""
Group Comparator (Firewall section): compares a playflows group, with all its nested subgroups,
between a reference firewall tag and every other tag where the group exists.

Data comes from the Group Lookup tables (pf_tag_group / pf_tag_group_children) filled by the
playflows_groups_update command.
"""
from collections import defaultdict, deque

from rss.models import PlayflowsTagGroup

GROUP_COMPARATOR_CSV_HEADER = ['FW tag', 'Subgroup', 'Added value', 'Missing value']


def load_group_maps_by_tag(root_group):
    """
    Return {tag_name: {group_name: {'members': set, 'subgroups': set}}} with root_group and all its
    nested subgroups, for every firewall tag where root_group exists.
    One query for the root groups, then one query per tree level that brings the children and their
    content at once, for all tags together (no N+1).
    """
    group_maps_by_tag = defaultdict(dict)
    group_index = {}

    def add_group(group_id, tag_name, name, content):
        group_index[group_id] = (tag_name, name)
        group = group_maps_by_tag[tag_name].setdefault(name, {'members': set(), 'subgroups': set()})
        group['members'].update(content or ())

    root_rows = PlayflowsTagGroup.objects.filter(name=root_group).values_list('id', 'tag__tag_name', 'name', 'content')
    for group_id, tag_name, name, content in root_rows:
        add_group(group_id, tag_name, name, content)

    level_ids = set(group_index)
    while level_ids:
        edges = PlayflowsTagGroup.children.through.objects.filter(
            from_playflowstaggroup_id__in=level_ids,
        ).values_list(
            'from_playflowstaggroup_id', 'to_playflowstaggroup_id',
            'to_playflowstaggroup__name', 'to_playflowstaggroup__content',
        )
        next_level_ids = set()
        for parent_id, child_id, child_name, child_content in edges:
            tag_name, parent_name = group_index[parent_id]
            group_maps_by_tag[tag_name][parent_name]['subgroups'].add(child_name)
            if child_id not in group_index:
                # Children always belong to the parent's tag (the sync only links groups of the same tag)
                add_group(child_id, tag_name, child_name, child_content)
                next_level_ids.add(child_id)
        level_ids = next_level_ids

    return dict(group_maps_by_tag)


def diff_group_maps(root_group, reference_map, target_map):
    """Return one row per group of the tree whose members or subgroups differ from the reference."""
    rows = []
    visited = set()
    pending = deque([(root_group, ())])
    while pending:
        group_name, subgroup_path = pending.popleft()
        if group_name in visited:
            continue
        visited.add(group_name)

        reference = reference_map[group_name]
        target = target_map[group_name]
        row = {
            'subgroup_path': subgroup_path,
            'added_values': sorted(target['members'] - reference['members']),
            'missing_values': sorted(reference['members'] - target['members']),
            'added_subgroups': sorted(target['subgroups'] - reference['subgroups']),
            'missing_subgroups': sorted(reference['subgroups'] - target['subgroups']),
        }
        if row['added_values'] or row['missing_values'] or row['added_subgroups'] or row['missing_subgroups']:
            rows.append(row)

        for child_name in sorted(reference['subgroups'] & target['subgroups']):
            pending.append((child_name, subgroup_path + (child_name,)))
    return rows


def build_alignment_commands(fw_tag, root_group, differences):
    """Return the playflows commands that align fw_tag with the reference (adds before removes)."""
    add_commands = []
    rm_commands = []
    for row in differences:
        group_name = row['subgroup_path'][-1] if row['subgroup_path'] else root_group
        target_group = f'{fw_tag}:{group_name}'
        for values in (row['missing_subgroups'], row['missing_values']):
            if values:
                add_commands.append(f'add to {target_group} {" ".join(values)}')
        for values in (row['added_subgroups'], row['added_values']):
            if values:
                rm_commands.append(f'rm from {target_group} {" ".join(values)}')
    return '\n'.join(add_commands + rm_commands)


def compare_group_across_firewalls(root_group, reference_tag, group_maps_by_tag):
    """Return the reference first, then the firewalls with differences, then the identical ones."""
    reference_map = group_maps_by_tag[reference_tag]
    firewalls = []
    for fw_tag in sorted(group_maps_by_tag):
        if fw_tag == reference_tag:
            continue
        differences = diff_group_maps(root_group, reference_map, group_maps_by_tag[fw_tag])
        firewalls.append({
            'fw_tag': fw_tag,
            'is_reference': False,
            'differences': differences,
            'added_count': sum(len(row['added_values']) + len(row['added_subgroups']) for row in differences),
            'missing_count': sum(len(row['missing_values']) + len(row['missing_subgroups']) for row in differences),
            'alignment_commands': build_alignment_commands(fw_tag, root_group, differences),
        })
    firewalls.sort(key=lambda firewall: not firewall['differences'])

    reference = {
        'fw_tag': reference_tag,
        'is_reference': True,
        'differences': [],
        'added_count': 0,
        'missing_count': 0,
        'alignment_commands': '',
    }
    return [reference] + firewalls


def build_group_comparator_csv_rows(firewalls):
    """One CSV row per difference; firewalls without differences (and the reference) get one empty row."""
    for firewall in firewalls:
        if not firewall['differences']:
            yield [firewall['fw_tag'], 'N/A', '', '']
            continue
        for row in firewall['differences']:
            yield [
                firewall['fw_tag'],
                ' > '.join(row['subgroup_path']) or 'N/A',
                ', '.join(row['added_subgroups'] + row['added_values']),
                ', '.join(row['missing_subgroups'] + row['missing_values']),
            ]
