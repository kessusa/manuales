import logging

logger = logging.getLogger(__name__)

MAX_MATCH_FLOW_CALLS = 12

FLOW_EXTRACTION_SYSTEM = (
    'You are a data extractor for network connectivity tickets. '
    'Return ONLY a valid JSON object with the keys: src_ip, dst_ip, protocol, port. '
    'Use null when a value is not present in the text. No markdown.'
)

INCIDENT_SYSTEM_PROMPT = (
    'You are a network security engineer investigating a ServiceNow connectivity incident.\n'
    'WORKFLOW:\n'
    '1. Call check_flow with src_ip, dst_ip and service (format protocol-port, e.g. tcp-3389). '
    'It returns the matching firewall rule directly.\n'
    '2. Conclude from its result:\n'
    '   - action accept: the firewall is NOT the issue; cite tag and rule position; '
    'suggest checking the endpoint/application.\n'
    '   - action drop or result no_match: the firewall is blocking the traffic; '
    'provide the tag name for the rule request.\n'
    '3. Only use get_topology_for_ip if check_flow errors or you need extra context.\n'
    'Never call the same tool with the same arguments twice.\n'
    'FINAL ANSWER FORMAT (plain text):\n'
    'ROOT CAUSE: <one sentence>\n'
    'EVIDENCE: <tag, rule position, action>\n'
    'NEXT STEPS: <what the operator should do>'
)

INCIDENT_TOOLS = [
    {
        'type': 'function',
        'function': {
            'name': 'check_flow',
            'description': 'Check if a firewall rule allows the flow src_ip -> dst_ip on a service. '
                           'Returns the matching rule (tag, position, action) or no_match.',
            'parameters': {
                'type': 'object',
                'properties': {
                    'src_ip': {'type': 'string', 'description': 'Source IP, e.g. 11.16.8.83'},
                    'dst_ip': {'type': 'string', 'description': 'Destination IP, e.g. 10.24.140.99'},
                    'service': {'type': 'string', 'description': 'Service as protocol-port, e.g. tcp-3389'},
                },
                'required': ['src_ip', 'dst_ip', 'service'],
            },
        },
    },
    {
        'type': 'function',
        'function': {
            'name': 'get_topology_for_ip',
            'description': 'Return the firewall tags and node names associated to an IP in the topology.',
            'parameters': {
                'type': 'object',
                'properties': {
                    'ip': {'type': 'string', 'description': 'IP address, e.g. 10.24.140.99'},
                },
                'required': ['ip'],
            },
        },
    },
]


# -------------------------------------------------------------------------
# Playflows tool handlers
# -------------------------------------------------------------------------
def build_playflows_handlers(playflows_api):
    """Return the handlers dict expected by LlmApi.run_tools, bound to a PlayflowsAPI instance."""
    state = {'sid': None}

    def get_sid():
        if not state['sid']:
            state['sid'] = playflows_api.get_sid()
        return state['sid']

    def get_topology(ip):
        """Normalize get_node_name output to a list of node dicts."""
        nodes = playflows_api.get_node_name(ip, get_sid())
        if not nodes:
            return []
        if isinstance(nodes, dict):
            nodes = nodes.get('data') if 'data' in nodes else [nodes]
        return [node for node in nodes if isinstance(node, dict)]

    def get_candidates(ip):
        """(node_name, firewall_tag) candidates for an IP, in topology order (first is most specific)."""
        candidates = []
        for node in get_topology(ip):
            candidate = (
                (node.get('node_normalization') or '').strip(),
                (node.get('firewall_misc') or '').strip(),
            )
            if candidate not in candidates:
                candidates.append(candidate)
        return candidates or [('', '')]

    def build_node_name_list(src_ip, src_name, src_tag, dst_ip, dst_name, dst_tag):
        """match_flow looks up item['ip_address'] == normalize_ip(flow ip) and the API returns
        flows with /32, so every IP goes in both forms (bare and /32)."""
        node_name_list = []
        for ip, name, tag in ((src_ip, src_name, src_tag), (dst_ip, dst_name, dst_tag)):
            for ip_form in (ip, f'{ip}/32'):
                node_name_list.append({
                    'ip_address': ip_form,
                    'node_normalization': name,
                    'firewall_misc': tag,
                })
        return node_name_list

    def get_topology_for_ip(ip):
        nodes = get_topology(ip)
        if not nodes:
            return {'ip': ip, 'nodes': [], 'meaning': 'IP not found in topology'}
        return {
            'ip': ip,
            'nodes': [
                {
                    'network': node.get('ip_address'),
                    'node_name': (node.get('node_normalization') or '').strip(),
                    'firewall_tag': (node.get('firewall_misc') or '').strip(),
                }
                for node in nodes
            ],
        }

    def check_flow(src_ip, dst_ip, service):
        sid = get_sid()
        src_candidates = get_candidates(src_ip)
        dst_candidates = get_candidates(dst_ip)
        all_tags = list(dict.fromkeys(tag for _, tag in src_candidates + dst_candidates if tag))
        if not all_tags:
            return {'error': f'No firewall tag found in topology for {src_ip} / {dst_ip}'}

        # match_flow uses only ONE firewall_misc per IP (next() by ip_address),
        # so candidate combinations are tried until one matches.
        tried = []
        for src_name, src_tag in src_candidates:
            for dst_name, dst_tag in dst_candidates:
                if len(tried) >= MAX_MATCH_FLOW_CALLS:
                    break
                tried.append({'src_tag': src_tag, 'dst_tag': dst_tag})
                result = playflows_api.match_flow(
                    sid=sid,
                    tag=all_tags,
                    source=src_ip,
                    destination=dst_ip,
                    service=service,
                    node_name_list=build_node_name_list(
                        src_ip, src_name, src_tag, dst_ip, dst_name, dst_tag
                    ),
                )
                if result:
                    return {
                        'result': 'match',
                        'src_tag': src_tag,
                        'dst_tag': dst_tag,
                        'matches': [
                            {
                                'tag': match.get('tag'),
                                'rule_position': match.get('position'),
                                'action': match.get('action'),
                                'flow': match.get('flow'),
                                'source_node': match.get('source_node_name'),
                                'destination_node': match.get('destination_node_name'),
                                'service': match.get('service'),
                            }
                            for match in result
                        ],
                    }
        return {
            'result': 'no_match',
            'meaning': 'No firewall rule matches this flow: the firewall is blocking it (implicit deny).',
            'tags_checked': all_tags,
            'combinations_tried': tried,
        }

    return {'check_flow': check_flow, 'get_topology_for_ip': get_topology_for_ip}


# -------------------------------------------------------------------------
# Orchestration
# -------------------------------------------------------------------------
def extract_network_flow(llm, ticket_text):
    """Single LLM call: src_ip / dst_ip / service from the ticket text. Returns dict or None."""
    flow = llm.ask_json(ticket_text, system=FLOW_EXTRACTION_SYSTEM)
    if not flow or not flow.get('src_ip') or not flow.get('dst_ip'):
        logger.error(f'LLM incident flow extraction failed: {flow}')
        return None
    protocol = (flow.get('protocol') or 'tcp').lower()
    port = flow.get('port')
    return {
        'src_ip': str(flow['src_ip']).strip(),
        'dst_ip': str(flow['dst_ip']).strip(),
        'service': f'{protocol}-{port}' if port else protocol,
    }


def investigate_incident(ticket_text, llm, playflows_api, ticket_number=None):
    """Full agent run over a ticket text. Returns dict with flow and analysis, or None."""
    flow = extract_network_flow(llm, ticket_text)
    if flow is None:
        return None

    messages = llm.build_messages(
        f'Ticket {ticket_number or ""}: {ticket_text}\n\n'
        f'Extracted flow: {flow["src_ip"]} -> {flow["dst_ip"]} {flow["service"]}',
        system=INCIDENT_SYSTEM_PROMPT,
    )
    handlers = build_playflows_handlers(playflows_api)
    message = llm.run_tools(messages, INCIDENT_TOOLS, handlers)
    if message is None:
        logger.error(f'LLM incident agent failed for ticket {ticket_number}')
        return None
    return {
        'ticket_number': ticket_number,
        'flow': flow,
        'analysis': message['content'],
        'tool_calls': sum(1 for item in messages if item.get('role') == 'tool'),
    }


def investigate_servicenow_incident(ticket_number, llm, servicenow_api, playflows_api):
    """Fetch the ticket from ServiceNow and run the agent. Returns dict or None."""
    ticket = servicenow_api.get_incident(ticket_number)
    if not ticket:
        logger.error(f'ServiceNow incident {ticket_number} not found')
        return None
    ticket_text = f"{ticket.get('short_description') or ''}\n{ticket.get('description') or ''}".strip()
    return investigate_incident(ticket_text, llm, playflows_api, ticket_number=ticket_number)
