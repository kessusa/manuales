SELECT id, COUNT(*) FROM pf_tag GROUP BY id HAVING COUNT(*) > 1;
SELECT COUNT(*) FROM pf_tag WHERE id IS NULL;

SELECT data_type, column_default
FROM information_schema.columns
WHERE table_name = 'pf_tag' AND column_name = 'id';

ALTER TABLE pf_tag ADD PRIMARY KEY (id);



CREATE SEQUENCE pf_tag_id_seq OWNED BY pf_tag.id;
SELECT setval('pf_tag_id_seq', COALESCE((SELECT MAX(id) FROM pf_tag), 0) + 1, false);
ALTER TABLE pf_tag ALTER COLUMN id SET DEFAULT nextval('pf_tag_id_seq');


SELECT c.relname,
       COUNT(con.oid) FILTER (WHERE con.contype = 'p') AS has_pk
FROM pg_class c
LEFT JOIN pg_constraint con ON con.conrelid = c.oid
WHERE c.relname IN ('pf_tag', 'pf_tag_group', 'pf_tag_group_link', 'pf_tag_audit')
GROUP BY c.relname;


SELECT EXISTS (SELECT 1 FROM pf_tag WHERE id = 1) AS tag_1_exists,
       (SELECT COUNT(*) FROM pf_tag_group) AS group_rows;
