function render_group_node(node, depth) {
                            let html = '';
                            const name_class = depth === 0
                                ? 'fw-bold text-primary mb-2'
                                : 'ps-' + Math.min(depth * 2, 4) + ' mt-2 fw-bold text-secondary';
                            html += `<div class="${name_class}" style="margin-left:${depth * 1.5}rem;">${node.group_name}</div>`;
                            (node.ips || []).forEach(ip => {
                                html += `<div class="text-secondary" style="margin-left:${(depth + 1) * 1.5}rem;">${ip}</div>`;
                            });
                            (node.subgroups || []).forEach(sub => {
                                html += render_group_node(sub, depth + 1);
                            });
                            return html;
                        }

